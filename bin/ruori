#!/usr/bin/env bash
# ruori - worktree context switcher (MVP)
#
# Run with no args in a terminal you keep open as your manager. Lists the
# git worktrees of the current repo, lets you fzf-pick one, then per pick:
#   - creates/reuses a named tmux session rooted in that worktree (a new
#     session starts `claude --resume`; an existing one is left running)
#   - opens/focuses a VS Code window rooted in that worktree
#   - opens a new iTerm2 window attached to that tmux session
# ...then loops back to the picker so this terminal stays the manager.
#
# Usage:
#   ruori               manager loop: pick a worktree, get an iTerm2 window, repeat
#   ruori new <branch> [start-point]
#                       create a sibling worktree for <branch> (new or existing)
#                       and immediately activate it, same as picking it would
#   ruori list          just print worktrees + which ones have an active tmux session

set -euo pipefail

for cmd in git tmux fzf code osascript; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "ruori: required command '$cmd' not found in PATH" >&2
    exit 1
  fi
done

# Resolved here (this script's own PATH), not left to be looked up again
# inside the iTerm2 window's spawned process: iTerm2 runs a profile's
# command directly rather than through a login shell, so it won't see
# PATH additions from ~/.zshrc etc. (e.g. Homebrew's tmux at
# /opt/homebrew/bin, which isn't on the default system PATH).
tmux_bin="$(command -v tmux)"

# Same reasoning as tmux_bin above, for the host-side `docker` the
# container-mode attach command execs into — may be empty for a repo
# that never uses container mode, which is fine, since only the
# container-mode attach path in open_iterm_window_for ever reads it, and
# require_docker_if_container_mode already guarantees it's resolvable by
# then.
docker_bin="$(command -v docker || true)"

if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "ruori: not inside a git repository" >&2
  exit 1
fi
repo_name="$(basename "$repo_root")"

# Default "current worktree" for the picker's marker column (see
# marker_for) — the main worktree, since `ruori` can only be launched from
# there (see the check below). Overridden by load_current_worktree
# (below main_worktree_path's own assignment) with whatever you last
# switched to, possibly in a previous run of `ruori` — this default is only
# what a brand-new repo with no `ruori` history yet would show.
current_worktree_path="$repo_root"

# Absolute path to this repo's shared git common dir (where linked
# worktrees' actual .git data lives) — one of the two paths bind-mounted
# into a container (the other being the worktree's own directory),
# required so a worktree's .git file (which points at an absolute host
# path inside this dir) resolves the same way inside the container.
# Defined this early (rather than down in the container-mode section
# below, where it conceptually belongs) because several state-file
# functions need it long before that section is reached, and bash only
# knows a function once it's read past its own definition.
#
# Memoized in _git_common_dir_cache: this is a fixed property of
# $repo_root, which never changes for the life of the process, but
# nearly every cache-file accessor and every log_file_read/write call
# goes through here — without caching, a single cold start fires a
# dozen-plus redundant `git rev-parse --git-common-dir` subprocesses.
# Every caller invokes this through `$(...)`/`<(...)`, which bash always
# runs in a forked subshell — so a cache write made *inside* the
# function body, on a call made that way, never survives back to this
# process; it would silently re-run the git subprocess on every call
# despite the cache. The `git_common_dir_prime` call right after this
# definition runs the function directly (not through a subshell),
# populating _git_common_dir_cache once in this process itself; every
# later `$(git_common_dir)` call then just reads and prints that
# already-known value from its own throwaway subshell instead of
# spawning git again.
_git_common_dir_cache=""
git_common_dir() {
  if [ -n "$_git_common_dir_cache" ]; then
    printf '%s' "$_git_common_dir_cache"
    return 0
  fi
  local common_dir
  common_dir="$(cd "$repo_root" && git rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$common_dir" in
    /*) ;;
    *) common_dir="$repo_root/$common_dir" ;;
  esac
  _git_common_dir_cache="$common_dir"
  printf '%s' "$common_dir"
}
git_common_dir_prime() {
  git_common_dir >/dev/null 2>&1 || true
}
git_common_dir_prime

# Every piece of ruori's own per-repo state (activation times, current-
# worktree, PR/usage caches, iTerm tracking, port allocations, and any
# shared container storage — see RUORI_SHARED_DIR in the container-mode
# section below) lives together under one subdirectory of the common
# git dir, rather than as loose ruori-prefixed files scattered directly
# in it — so all of it can be cleared in one shot (`rm -rf` this
# directory) without touching anything else there, and without needing
# to know every individual filename first. Creates the directory on
# demand since every caller immediately writes into or reads from it.
ruori_state_dir() {
  local common_dir dir
  common_dir="$(git_common_dir)" || return 1
  dir="$common_dir/ruori"
  mkdir -p "$dir" 2>/dev/null || true
  printf '%s' "$dir"
}

sanitize() {
  # tmux session names: avoid '.' and ':' which have special meaning
  printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '-'
}

# --- file I/O logging (docs/troubleshooting.md) ---
# Every read/write ruori's own code performs against a file — state/cache
# files, .ruori.conf, a worktree copy-in, a generated Dockerfile-adjacent
# file — is recorded here, append-only, for troubleshooting/transparency:
# same convention as iterm.log below (never rotated; see that comment for
# why), and for the same reason — by the time you notice a config file
# didn't get copied or a cache looks stale, whatever ruori actually did is
# otherwise gone. Scope: only file I/O ruori's own script code performs
# directly (a read/cat/redirect/cp/mv it runs). File access performed
# *inside* a child process it shells out to (git, docker, code, fzf,
# osascript) isn't observable from here without OS-level tracing, so
# those aren't logged. Writes to this log file itself are excluded too,
# to avoid unbounded self-referential growth.
fileio_log_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/file-io.log' "$state_dir"
}

log_file_read() {
  local f
  f="$(fileio_log_file)" || return 0
  printf '%s READ  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$f" 2>/dev/null || true
}

log_file_write() {
  local f
  f="$(fileio_log_file)" || return 0
  printf '%s WRITE %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$f" 2>/dev/null || true
}

# Cache file recording, per worktree path, the epoch time it was last
# activated (switched to — see save_activation_time, called from the
# manager loop below). Drives sort_worktrees_by_activation, which the
# picker/list use so the most recently activated worktree always sorts
# first instead of whatever order `git worktree list` happens to return
# (~creation order). Cached under the repo's common git dir, like the
# current-worktree/PR/usage caches (see current_worktree_cache_file).
activation_times_cache_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/activation-times' "$state_dir"
}

declare -A activation_time_for_path

load_activation_times() {
  activation_time_for_path=()
  local cache_file epoch path
  cache_file="$(activation_times_cache_file)" || return 0
  [ -f "$cache_file" ] || return 0
  log_file_read "$cache_file"
  while IFS=$'\t' read -r epoch path; do
    [ -n "$path" ] || continue
    activation_time_for_path["$path"]="$epoch"
  done <"$cache_file"
}

# Records that `path` was just activated, so it sorts to the top of
# future picker/list views. Rewrites the whole cache file from the
# in-memory map (rather than appending) so it can't grow unbounded and
# never needs pruning when a worktree is later removed.
save_activation_time() {
  local path="$1" cache_file tmp p
  cache_file="$(activation_times_cache_file)" || return 0
  activation_time_for_path["$path"]="$(date +%s)"
  tmp="$(mktemp -t ruori-activation-times)"
  for p in "${!activation_time_for_path[@]}"; do
    printf '%s\t%s\n' "${activation_time_for_path[$p]}" "$p"
  done >"$tmp"
  log_file_write "$cache_file"
  mv "$tmp" "$cache_file"
}

# Reorders paths/branches (in place) so the most recently activated
# worktree comes first, then next-most-recent, etc. Worktrees never
# activated (epoch 0, the default) keep their relative
# `git worktree list` order and sort after every activated one — `sort
# -s` (stable) guarantees ties keep their input order rather than being
# reversed by `-r`.
sort_worktrees_by_activation() {
  load_activation_times
  local i epoch
  local -a keyed=()
  for i in "${!paths[@]}"; do
    epoch="${activation_time_for_path[${paths[$i]}]:-0}"
    keyed+=("${epoch}"$'\t'"${i}")
  done
  local -a sorted_indices=()
  local idx
  while IFS=$'\t' read -r _ idx; do
    sorted_indices+=("$idx")
  done < <(printf '%s\n' "${keyed[@]}" | sort -t $'\t' -k1,1nr -s)
  local -a new_paths=() new_branches=()
  for idx in "${sorted_indices[@]}"; do
    new_paths+=("${paths[$idx]}")
    new_branches+=("${branches[$idx]}")
  done
  paths=("${new_paths[@]}")
  branches=("${new_branches[@]}")
}

# --- parse `git worktree list --porcelain` into parallel arrays ---
# A function (not inline top-level code) because the worktree list can now
# change mid-session — `ruori rm`/the Enter menu's "delete worktree"
# delete one — so the manager loop
# re-parses on every iteration instead of trusting arrays built once at
# startup, which would otherwise go stale and desync from what the picker
# (each reload is its own fresh process, so it always sees current state)
# is actually showing.
parse_worktrees() {
  paths=()
  branches=()

  local current_path="" current_branch="" current_head="" current_bare="0" have_entry=0

  flush_entry() {
    [ "$have_entry" -eq 1 ] || return 0
    [ "$current_bare" = "1" ] && { have_entry=0; return 0; }
    if [ -z "$current_branch" ]; then
      # detached (or otherwise branchless) worktree: use short SHA, fall back
      # to the worktree's directory name if HEAD is somehow unavailable.
      if [ -n "$current_head" ]; then
        current_branch="(detached@${current_head:0:8})"
      else
        current_branch="(detached:$(basename "$current_path"))"
      fi
    fi
    paths+=("$current_path")
    branches+=("$current_branch")
    have_entry=0
  }

  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        flush_entry
        current_path="${line#worktree }"
        current_branch=""
        current_head=""
        current_bare="0"
        have_entry=1
        ;;
      branch\ *)
        current_branch="${line#branch refs/heads/}"
        ;;
      HEAD\ *)
        current_head="${line#HEAD }"
        ;;
      detached)
        current_branch=""
        ;;
      bare)
        current_bare="1"
        ;;
    esac
  done < <(git worktree list --porcelain)
  flush_entry

  if [ "${#paths[@]}" -eq 0 ]; then
    echo "ruori: no worktrees found for $repo_root" >&2
    exit 1
  fi

  # `git worktree list` always lists the main worktree first (the one with
  # a real .git directory, as opposed to a linked worktree's .git file) —
  # grab it before sort_worktrees_by_activation reorders paths/branches.
  main_worktree_path="${paths[0]}"

  sort_worktrees_by_activation
}

parse_worktrees

# `ruori` must be launched from the main worktree, not a linked one: several
# things below key off `repo_root` (the tmux session-name prefix via
# `repo_name`, the PR/usage/current-worktree cache file locations) on the
# assumption that it's a single stable, repo-wide identity — but
# `git rev-parse --show-toplevel` actually resolves to whichever
# worktree's tree you're standing in when you run it. Launching from a
# linked worktree would silently give those a different value each time
# (e.g. tmux session names for the very same worktree changing depending
# on where you happened to launch `ruori` from), rather than failing loudly.
if [ "$repo_root" != "$main_worktree_path" ]; then
  echo "ruori: must be run from the main worktree, not a linked one." >&2
  echo "ruori: you're in:    $repo_root" >&2
  echo "ruori: main worktree: $main_worktree_path" >&2
  echo "ruori: cd there and run ruori again." >&2
  exit 1
fi

# Per-repo config file, created by the user (ruori never writes it) at the
# main worktree's root. Each non-blank, non-comment (#) line is
# "<directive> <value>" — e.g. "copy .env.*" — so the file can grow more
# kinds of setting later (editor override, port base, ...) without
# changing its shape; unrecognized directives are warned about and
# skipped rather than breaking parsing.
CONFIG_FILENAME=".ruori.conf"

# Emits "<directive>\t<value>" for each config line, trimmed and with
# comments stripped. If the config file doesn't exist, emits nothing —
# callers apply their own defaults in that case.
#
# Memoized in _config_directives_cache: ruori never writes this file
# itself (see comment above), so it's a fixed input for the life of the
# process — but nearly a dozen accessors (copy_patterns,
# container_mode_enabled, container_file_path, container_ports, ...)
# each call this, and in container mode some of those run again per
# worktree row on every picker draw. Without caching that's a full
# re-read-and-reparse of the file per call instead of once per process.
# Every caller invokes this through `$(...)`/`<(...)` (a forked
# subshell), so — same reasoning as git_common_dir_prime above — a
# cache write made inside one of those calls never survives back to
# this process; config_directives_prime right below runs the function
# directly once, so every later subshelled call just reads the
# already-populated cache instead of re-reading the file.
_config_directives_cache=""
_config_directives_cache_loaded=0
config_directives() {
  if [ "$_config_directives_cache_loaded" -eq 1 ]; then
    [ -n "$_config_directives_cache" ] && printf '%s' "$_config_directives_cache"
    return 0
  fi
  _config_directives_cache_loaded=1
  local config_file="$main_worktree_path/$CONFIG_FILENAME"
  [ -f "$config_file" ] || return 0
  log_file_read "$config_file"
  local line key value out=""
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
    line="${line%"${line##*[![:space:]]}"}"   # trim trailing whitespace
    [ -n "$line" ] || continue
    read -r key value <<<"$line"
    out+="$key"$'\t'"$value"$'\n'
  done <"$config_file"
  _config_directives_cache="$out"
  printf '%s' "$out"
}
config_directives_prime() {
  config_directives >/dev/null 2>&1 || true
}
config_directives_prime

# All directive keys any accessor below understands. Checked once here
# (warn_unknown_directives) rather than in copy_patterns itself, since
# copy_patterns is no longer the only consumer of config_directives —
# each new accessor (container_mode_enabled, container_file_path,
# container_ports, container_copy_entries) matches only its own key(s),
# so this is the single shared place unrecognized keys get flagged.
KNOWN_CONFIG_DIRECTIVES="copy container container-file container-port container-copy container-host-port container-volume container-overlay"

warn_unknown_directives() {
  local key value known k
  while IFS=$'\t' read -r key value; do
    known=0
    for k in $KNOWN_CONFIG_DIRECTIVES; do
      [ "$key" = "$k" ] && { known=1; break; }
    done
    [ "$known" = "1" ] || echo "ruori: ${CONFIG_FILENAME}: unknown directive '$key' (ignored)" >&2
  done < <(config_directives)
}

# The "copy" directive's values: glob patterns (relative to the main
# worktree root) of files to copy into a worktree missing them. Plain
# filenames match exactly (a full path, e.g. "config/local.json", too);
# shell wildcards (*, ?, [...]) work as well, including partway through
# a path (e.g. "config/*.local.json"), and "**" matches across
# subdirectories (e.g. "**/.env" for every .env under the repo, at any
# depth) — see sync_env_files, which enables globstar for the expansion.
# No config file, or one with no "copy" lines, means nothing gets
# copied — opt in explicitly rather than relying on a hardcoded default.
copy_patterns() {
  local config_file="$main_worktree_path/$CONFIG_FILENAME"
  [ -f "$config_file" ] || return 0
  local key value
  while IFS=$'\t' read -r key value; do
    [ "$key" = "copy" ] || continue
    [ -n "$value" ] && printf '%s\n' "$value"
  done < <(config_directives)
}

# `container on` (bare `container`, i.e. an empty value, also works) is
# the sole container-mode opt-in signal — see
# docs/container-sandbox-plan.md decision I. A Dockerfile existing on
# disk is deliberately NOT treated as opt-in: a repo could have an
# unrelated pre-existing .devcontainer/Dockerfile.
container_mode_enabled() {
  local key value
  while IFS=$'\t' read -r key value; do
    if [ "$key" = "container" ]; then
      case "$value" in
        ''|on) return 0 ;;
        off) return 1 ;;
      esac
    fi
  done < <(config_directives)
  return 1
}

CONTAINER_FILE_DEFAULT=".devcontainer/Dockerfile"

# `container-file <path>` — Dockerfile path relative to the main
# worktree root; defaults to CONTAINER_FILE_DEFAULT if not given.
container_file_path() {
  local key value result="$CONTAINER_FILE_DEFAULT"
  while IFS=$'\t' read -r key value; do
    [ "$key" = "container-file" ] && [ -n "$value" ] && result="$value"
  done < <(config_directives)
  printf '%s' "$result"
}

# One "<container-port>\t<name>\t<type>" line per `container-port
# <port>[:<name>][:http]` directive, in config order (<name>/<type>
# empty when not given). The optional trailing ":http" only splits off
# the tail *after* the first colon, so a directive with no type suffix
# parses exactly as it always has -- existing configs need no changes.
# "http" is (for now) the only recognized <type>; it marks a port as an
# HTTP server so browser_links_for can offer a clickable link for it,
# as opposed to e.g. a database port that isn't browser-able.
container_ports() {
  local key value port rest name type
  while IFS=$'\t' read -r key value; do
    [ "$key" = "container-port" ] || continue
    [ -n "$value" ] || continue
    port="${value%%:*}"
    if [ "$value" = "$port" ]; then
      name=""
      type=""
    else
      rest="${value#*:}"
      if [ "$rest" != "${rest%%:*}" ]; then
        name="${rest%%:*}"
        type="${rest#*:}"
      else
        name="$rest"
        type=""
      fi
    fi
    printf '%s\t%s\t%s\n' "$port" "$name" "$type"
  done < <(config_directives)
}

# One "<host-path>\t<container-path>" line per `container-copy
# <host-path>[:<container-path>]` directive (<container-path> defaults to
# <host-path> when no ":<container-path>" was given). Only a literal
# leading "~/" is expanded (to $HOME) — no eval/arbitrary shell expansion
# of a value that comes straight from a config file, so a crafted config
# can't execute anything at parse time.
container_copy_entries() {
  local key value host_path container_path has_container_path=0
  while IFS=$'\t' read -r key value; do
    [ "$key" = "container-copy" ] || continue
    [ -n "$value" ] || continue
    host_path="${value%%:*}"
    if [ "$value" = "$host_path" ]; then
      has_container_path=0
    else
      container_path="${value#*:}"
      has_container_path=1
    fi
    # Only ~/ in host_path means anything to expand here — $HOME is a
    # host concept; a "~/..." container_path is used as a literal path
    # (the container's own filesystem layout, likely a different user
    # entirely, e.g. /root), never expanded against the host's $HOME.
    case "$host_path" in
      '~/'*) host_path="$HOME/${host_path#'~/'}" ;;
    esac
    # No explicit container-path: mirror the (now-expanded) host path
    # verbatim inside the container, same "matching paths" convention
    # the worktree/git-common-dir mounts already use.
    [ "$has_container_path" = "1" ] || container_path="$host_path"
    printf '%s\t%s\n' "$host_path" "$container_path"
  done < <(config_directives)
}

# One "<relpath>\t<patch-file>" line per `container-overlay <relpath>
# <patch-file>` directive. <relpath> (relative to the worktree root) is
# the file to override inside the container only; <patch-file> is a
# unified diff, relative to $main_worktree_path (same resolution
# convention `copy` patterns use), meant to be authored once via
# `git diff -- <relpath> > <patch-file>` and tracked in git alongside
# .ruori.conf/the Dockerfile. See container_overlay_refresh_one for how
# it's applied. Neither argument gets "~/" expansion (unlike
# container_copy_entries' host_path) -- both are always repo-relative,
# never a host-absolute path.
container_overlay_entries() {
  local key value relpath patchfile
  while IFS=$'\t' read -r key value; do
    [ "$key" = "container-overlay" ] || continue
    [ -n "$value" ] || continue
    read -r relpath patchfile <<<"$value"
    [ -n "$relpath" ] && [ -n "$patchfile" ] || continue
    printf '%s\t%s\n' "$relpath" "$patchfile"
  done < <(config_directives)
}

# One "<port>" line per `container-host-port <port>` directive, in
# config order. See container_start_host_port_forwards below for what
# this actually does inside the container.
container_host_ports() {
  local key value
  while IFS=$'\t' read -r key value; do
    [ "$key" = "container-host-port" ] || continue
    [ -n "$value" ] || continue
    printf '%s\n' "$value"
  done < <(config_directives)
}

# One "<relative-path>" line per `container-volume <relative-path>`
# directive, in config order. <relative-path> (relative to the worktree
# root) gets its own Docker-managed volume instead of living on the
# bind-mounted worktree — see container_volume_name_for and the extra
# `docker run -v` flag it feeds in container_start_if_needed. Opt-in,
# repo-specific: this directive carries no assumption about what the
# path is for (a repo's own node_modules being the motivating case is
# incidental, not something this accessor or its caller know about).
container_native_volumes() {
  local key value
  while IFS=$'\t' read -r key value; do
    [ "$key" = "container-volume" ] || continue
    [ -n "$value" ] || continue
    printf '%s\n' "$value"
  done < <(config_directives)
}

# Deterministic per-(worktree, subpath) Docker volume name for a
# `container-volume` entry — no cache file needed (unlike ports, which
# need one specifically because free-port scanning is non-deterministic;
# a volume name has no such collision to resolve). Also the name prefix
# ("$session__vol-") that delete_worktree/resources later query by, so
# cleanup/listing works even if the directive that created a volume has
# since been edited or removed from .ruori.conf.
container_volume_name_for() {
  local session="$1" relpath="$2"
  printf '%s__vol-%s' "$session" "$(sanitize "$relpath")"
}

# Warns when the `container-volume` directives in .ruori.conf differ
# from the volumes container $1 was actually created with. Docker can't
# add or drop a mount on an existing container, so a directive added
# or removed since (e.g. a new workspace package's node_modules) only
# takes effect on `ruori rebuild`; this is what tells you that's
# pending. One `docker inspect` per activation, not per picker draw.
warn_container_volume_drift() {
  local name="$1" path="$2" branch="$3" want have missing extra
  want="$(container_native_volumes | sort -u)"
  have="$(docker inspect -f '{{range .Mounts}}{{if eq .Type "volume"}}{{.Destination}}{{"\n"}}{{end}}{{end}}' "$name" 2>/dev/null \
    | sed -n "s|^${path}/||p" | sort)"
  [ "$want" = "$have" ] && return 0
  missing="$(comm -23 <(printf '%s\n' "$want") <(printf '%s\n' "$have") | sed '/^$/d; s/^/+/' | paste -sd' ' -)"
  extra="$(comm -13 <(printf '%s\n' "$want") <(printf '%s\n' "$have") | sed '/^$/d; s/^/-/' | paste -sd' ' -)"
  echo "ruori: container-volume targets changed (${missing}${missing:+ }${extra}); run 'ruori rebuild ${branch}' to apply" >&2
}

# Directory holding every generated container-overlay file, one level
# under ruori_state_dir -- kept in its own subdirectory so a `rm -rf` of
# it alone clears every overlay's generated content without touching
# the rest of ruori's state, and so `ruori resources`/troubleshooting
# has one place to point at.
container_overlay_state_dir() {
  local state_dir dir
  state_dir="$(ruori_state_dir)" || return 1
  dir="$state_dir/overlays"
  mkdir -p "$dir" 2>/dev/null || true
  printf '%s' "$dir"
}

# Deterministic per-(session, relpath) path for a container-overlay's
# generated (patched) content -- same sanitize()-the-relpath convention
# as container_volume_name_for, so a nested relpath like
# "config/vite.config.js" becomes one flat, collision-safe filename.
container_overlay_generated_file_for() {
  local session="$1" relpath="$2" dir
  dir="$(container_overlay_state_dir)" || return 1
  printf '%s/%s__%s' "$dir" "$session" "$(sanitize "$relpath")"
}

# Append-only log of container-overlay patch-apply failures, same
# convention as iterm.log/file-io.log (docs/troubleshooting.md): a
# transient stderr line in a tmux pane no one's watching is easy to
# miss, and by the time you notice a container is serving a stale
# overlay, the in-process reason why is long gone. Never rotated.
overlay_log_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/overlay.log' "$state_dir"
}

log_overlay() {
  local f
  f="$(overlay_log_file)" || return 0
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$f" 2>/dev/null || true
}

# Generates one container-overlay's file: applies <patch-file>
# (resolved relative to $main_worktree_path) to the CURRENT content of
# $worktree_path/<relpath> -- whatever the host file looks like right
# now, not a frozen snapshot from whenever the patch was authored --
# writing the result to the generated file that container_start_if_needed
# bind-mounts over <relpath> inside a brand-new container. Only ever
# runs once per container lifetime, right before that container's
# `docker run` (at first creation, or at `ruori rebuild`): a
# container-overlay directive says "give each new container the current
# host file patched this way," not "keep an already-running container's
# view live" -- there's no per-activation refresh, so an existing
# container never needs to re-read this.
#
# On failure (the patch doesn't apply against the current host
# content), the previously-generated file, if any, is left completely
# untouched, so a `ruori rebuild` that hits a broken patch still gets a
# working (if possibly stale) overlay instead of none -- and the
# failure is logged. Returns 1 so callers can decide how loudly to
# warn. -o/-r point outside the worktree entirely so a failed or fuzzy
# apply never drops a .rej/.orig file next to the real, tracked host
# file; -F0 (zero fuzz) is deliberate too -- a fuzzy "successful" apply
# can silently produce wrong content, which is worse than the
# documented "keep last-good" fallback.
container_overlay_refresh_one() {
  local session="$1" worktree_path="$2" relpath="$3" patch_rel="$4"
  local host_file="$worktree_path/$relpath"
  local patch_file="$main_worktree_path/$patch_rel"
  local generated_file scratch rejfile

  generated_file="$(container_overlay_generated_file_for "$session" "$relpath")" || return 1
  scratch="${generated_file}.staging"
  rejfile="${generated_file}.rej"

  if [ ! -f "$host_file" ]; then
    log_overlay "FAIL session=$session relpath=$relpath reason='host file not found: $host_file'"
    return 1
  fi
  if [ ! -f "$patch_file" ]; then
    log_overlay "FAIL session=$session relpath=$relpath reason='patch file not found: $patch_file'"
    return 1
  fi

  log_file_read "$host_file"
  log_file_read "$patch_file"
  rm -f "$scratch" "$rejfile"
  if patch -i "$patch_file" -o "$scratch" -r "$rejfile" -F0 "$host_file" >/dev/null 2>&1; then
    cat "$scratch" >"$generated_file"
    log_file_write "$generated_file"
    rm -f "$scratch" "$rejfile"
    return 0
  else
    log_overlay "FAIL session=$session relpath=$relpath patch=$patch_rel reason='patch did not apply cleanly against current host content (see $rejfile)'"
    rm -f "$scratch"
    return 1
  fi
}

# Warns when the `container-overlay` directives in .ruori.conf differ
# from the overlay mounts container $1 was actually created with --
# same reasoning and shape as warn_container_volume_drift: Docker can't
# add or drop a mount on an existing container, so an added/removed
# directive only takes effect on `ruori rebuild`. Matched by mount
# *source* prefix (container_overlay_state_dir), not destination alone,
# so this never confuses an overlay mount with the plain worktree bind
# mount or the common-git-dir bind mount, both of which are also Type
# "bind" and can also land under "$path/..." for the main worktree
# (whose common dir is "$path/.git").
#
# On Docker Desktop for Mac, `docker inspect` sometimes reports a bind
# mount's Source through the VM's raw view, prefixed with "/host_mnt"
# (e.g. "/host_mnt/Users/..." instead of "/Users/..."), rather than the
# plain host path ruori itself passed to `-v`. Observed specifically
# for the overlay mount, which is a subpath of the common-git-dir mount
# that's *also* separately bind-mounted whole into every container --
# every worktree of a repo shares one common dir, so with more than one
# worktree's container running at once (the normal case), a new
# container's overlay mount can be nested inside a host path another,
# already-running container has mounted too; a container created with
# no such overlap in play doesn't show it. Left unstripped, this makes
# a correctly-mounted overlay look "missing" -- a false positive, not
# real drift. Stripping a leading "/host_mnt" (a no-op where it's
# absent) before matching fixes this regardless of the exact trigger.
# See docs/gimmicks.md.
warn_container_overlay_drift() {
  local name="$1" path="$2" branch="$3" overlay_dir want have missing extra
  overlay_dir="$(container_overlay_state_dir)" || return 0
  want="$(container_overlay_entries | cut -f1 | sort -u)"
  have="$(docker inspect -f '{{range .Mounts}}{{if eq .Type "bind"}}{{.Source}}{{"\t"}}{{.Destination}}{{"\n"}}{{end}}{{end}}' "$name" 2>/dev/null \
    | sed 's|^/host_mnt/|/|' \
    | awk -F'\t' -v d="$overlay_dir/" 'index($1,d)==1{print $2}' \
    | sed -n "s|^${path}/||p" | sort -u)"
  [ "$want" = "$have" ] && return 0
  missing="$(comm -23 <(printf '%s\n' "$want") <(printf '%s\n' "$have") | sed '/^$/d; s/^/+/' | paste -sd' ' -)"
  extra="$(comm -13 <(printf '%s\n' "$want") <(printf '%s\n' "$have") | sed '/^$/d; s/^/-/' | paste -sd' ' -)"
  echo "ruori: container-overlay targets changed (${missing}${missing:+ }${extra}); run 'ruori rebuild ${branch}' to apply" >&2
}

# Copy any files matching the configured patterns (see copy_patterns/
# CONFIG_FILENAME above) from the main worktree into the target worktree,
# skipping ones that already exist there (never overwrites — e.g. a
# tracked .env.example that git worktree already checked out).
# Gitignored, machine-local files aren't part of the checkout, so a fresh
# worktree otherwise starts with none of them.
sync_env_files() {
  local target_path="$1"
  [ "$target_path" = "$main_worktree_path" ] && return 0

  # globstar makes "**" in a pattern match across subdirectories (e.g.
  # "**/.env"); save/restore the prior setting since nothing else in the
  # script relies on it and a caller's own shell shouldn't be affected.
  local had_globstar=1
  shopt -q globstar || had_globstar=0
  shopt -s globstar

  local pattern f rel target_file
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    for f in "$main_worktree_path"/$pattern; do
      [ -f "$f" ] || continue
      rel="${f#"$main_worktree_path"/}"
      target_file="$target_path/$rel"
      if [ ! -e "$target_file" ]; then
        mkdir -p "$(dirname "$target_file")"
        log_file_read "$f"
        log_file_write "$target_file"
        cp "$f" "$target_file"
        echo "ruori: copied $rel into worktree"
      fi
    done
  done < <(copy_patterns)

  [ "$had_globstar" = "1" ] || shopt -u globstar
}

path_hash_for() {
  printf '%s' "$1" | cksum | cut -d' ' -f1
}

session_name_for() {
  local branch="$1"
  local path="$2"
  # Include a short hash of the full path as a uniqueness suffix, since
  # sanitize() is lossy (e.g. 'feat/a' and 'feat-a' both become 'feat-a')
  # and detached/no-branch worktrees could otherwise still collide.
  echo "$(sanitize "$repo_name")__$(sanitize "$branch")__$(path_hash_for "$path")"
}

# --- container mode (see docs/container-sandbox-plan.md) ---
#
# `ruori` never decides what runs inside a container's tmux session (see
# the main loop below) — this section only orchestrates the container's
# own lifecycle: image build, start/stop, mounts, ports, copy-in.

# One image per repo (not per worktree) — the Dockerfile is the same
# file regardless of which worktree uses it; only mounts/ports differ
# per container instance.
#
# Lowercased on top of sanitize(): Docker repository names must be
# lowercase (unlike the tmux/container names sanitize() is normally used
# for, which tolerate mixed case), so a repo like "packPixie" would
# otherwise fail the build with "repository name must be lowercase".
container_image_for() {
  printf 'ruori/%s:latest' "$(sanitize "$repo_name" | tr 'A-Z' 'a-z')"
}

container_running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]
}

# Distinguishes "stopped, needs `docker start`" from "never created,
# needs `docker run`" — a container can outlive a host reboot as a
# stopped object.
container_exists() {
  docker inspect "$1" >/dev/null 2>&1
}

# Bulk state/id lookup for every container in one `docker ps` call,
# populated once per picker draw (see call sites in the __fzfgen/
# __fzfgen_fetch/manager-loop bodies below) rather than doing a
# `docker inspect` round-trip per worktree row: on a repo with many
# worktrees, each individual round-trip to the Docker daemon adds real
# wall-clock time (Docker Desktop's gRPC boundary is not cheap per
# call), and this is the one part of a picker draw whose cost scales
# with worktree count. `docker ps -a` state values are "created",
# "running", "paused", "restarting", "removing", "exited", or "dead" —
# container_state_for below only distinguishes "running" from anything
# else that exists, matching its pre-existing running/stopped/none
# contract.
declare -A _docker_state_by_name=()
declare -A _docker_id_by_name=()
_docker_table_loaded=0
refresh_docker_container_table() {
  _docker_state_by_name=()
  _docker_id_by_name=()
  local name state id
  while IFS=$'\t' read -r name state id; do
    [ -n "$name" ] || continue
    _docker_state_by_name["$name"]="$state"
    _docker_id_by_name["$name"]="$id"
  done < <(docker ps -a --format '{{.Names}}\t{{.State}}\t{{.ID}}' 2>/dev/null)
  _docker_table_loaded=1
}

# "running" / "stopped" / "none" for the container named $1 (the session
# name — one container per worktree). Used by the picker's status column
# and preview panel in container mode; the Enter menu's "stop container"
# does `docker stop`, so "stopped" is exactly what a picker refresh shows
# right after. Reads from the bulk table above when a draw has populated
# it; falls back to a single `docker inspect` call otherwise (e.g. the
# Enter action menu's one-off preview, which never loops over every
# worktree so doesn't bother refreshing the table).
container_state_for() {
  local session="$1"
  if [ "$_docker_table_loaded" = "1" ]; then
    local st="${_docker_state_by_name[$session]:-}"
    if [ -z "$st" ]; then
      echo "none"
    elif [ "$st" = "running" ]; then
      echo "running"
    else
      echo "stopped"
    fi
    return
  fi
  local running
  running="$(docker inspect -f '{{.State.Running}}' "$session" 2>/dev/null)" || { echo "none"; return; }
  if [ "$running" = "true" ]; then
    echo "running"
  else
    echo "stopped"
  fi
}

# One repo-wide image (see container_image_for), so this is the same for
# every row in the picker. Memoized in _container_image_info_cache: the
# comment above already documented the intent ("called once per draw,
# not per worktree"), but the picker's per-row loop (fzf_line_for)
# called this once per worktree anyway, each doing its own redundant
# `docker image inspect` — this cache makes the code match the intent.
_container_image_info_cache=""
_container_image_info_cache_loaded=0
container_image_info_for() {
  if [ "$_container_image_info_cache_loaded" -eq 1 ]; then
    printf '%s' "$_container_image_info_cache"
    return 0
  fi
  _container_image_info_cache_loaded=1
  local image
  image="$(container_image_for)"
  if docker image inspect "$image" >/dev/null 2>&1; then
    _container_image_info_cache="$image (built)"
  else
    _container_image_info_cache="$image (not built)"
  fi
  printf '%s' "$_container_image_info_cache"
}

# Short (12-char) container id for session $1, or "-" if the container
# doesn't exist yet. Shown next to the container name in the preview
# panel. Same bulk-table/fallback split as container_state_for above.
container_id_for() {
  local session="$1" id
  if [ "$_docker_table_loaded" = "1" ]; then
    id="${_docker_id_by_name[$session]:-}"
  else
    id="$(docker inspect -f '{{.Id}}' "$session" 2>/dev/null)"
  fi
  if [ -n "$id" ]; then
    printf '%s' "${id:0:12}"
  else
    printf '%s' "-"
  fi
}

# A curated set of xterm-256 color indices, picked bright/distinct
# enough to read as both tmux status-bar background and picker
# foreground text (see below), and different enough from each other
# that a handful of worktrees stay visually distinguishable. Kept fairly
# wide (16 entries) since the hash below has no collision-avoidance --
# two containers landing on the same color is a coincidence you just
# live with, same as port_seed_for's hash-derived starting port above;
# a wider palette only makes that coincidence less likely, never
# impossible, without a lookup file to actually guarantee uniqueness.
CONTAINER_COLOR_PALETTE=(208 178 68 141 204 71 39 213 173 111 155 176 80 214 135 121)

# Deterministically maps session $1 to one entry of the palette above,
# so the same container always gets the same color across manager
# restarts with no lookup file to keep in sync (issue #30) -- reusing
# the cksum-hash idiom path_hash_for already uses for session naming.
# Used to color both this container's tmux status bar (activate_worktree)
# and its row in the picker (fzf_line_for), so the two visibly match.
container_color_for() {
  local session="$1" hash
  hash="$(printf '%s' "$session" | cksum | cut -d' ' -f1)"
  printf '%s' "${CONTAINER_COLOR_PALETTE[$((hash % ${#CONTAINER_COLOR_PALETTE[@]}))]}"
}

# Host->container port mappings actually allocated for session $1 (see
# allocate_port_for/ports_cache_file), comma-separated, or "-" if none.
container_ports_info_for() {
  local session="$1" cache_file s cp hp parts=()
  cache_file="$(ports_cache_file)" || { echo "-"; return; }
  [ -f "$cache_file" ] || { echo "-"; return; }
  log_file_read "$cache_file"
  while IFS=$'\t' read -r s cp hp; do
    [ "$s" = "$session" ] || continue
    parts+=("${hp}->${cp}")
  done <"$cache_file"
  if [ "${#parts[@]}" -eq 0 ]; then
    echo "-"
  else
    local IFS=,
    echo "${parts[*]}"
  fi
}

# Wraps $2 (display text, defaults to $1 itself) in an OSC 8 terminal
# hyperlink pointing at url $1. Terminals that don't understand OSC 8
# (fzf's preview pane included) just print the surrounding escape
# bytes as inert filler around the still-readable text, so this is
# safe to use unconditionally rather than needing a capability check.
osc8_link() {
  local url="$1" text="${2:-$1}"
  printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$text"
}

# One "<label>\thttp://localhost:<host-port>" line per host port
# session $1 has allocated (see allocate_port_for/ports_cache_file)
# whose `container-port` directive was marked ":http" (see
# container_ports) -- i.e. only the ports actually worth offering a
# browser link for, not every container-port (a database port, say,
# isn't browser-able). Empty output if this repo has no ":http"-typed
# ports, or this session hasn't allocated any yet (container never
# started). label falls back to the container port itself when no
# ":<name>" was given.
browser_links_for() {
  local session="$1" cache_file s cp hp
  local -A http_label=()
  local port name type
  while IFS=$'\t' read -r port name type; do
    [ "$type" = "http" ] || continue
    http_label["$port"]="${name:-$port}"
  done < <(container_ports)
  [ "${#http_label[@]}" -gt 0 ] || return 0

  cache_file="$(ports_cache_file)" || return 0
  [ -f "$cache_file" ] || return 0
  log_file_read "$cache_file"
  while IFS=$'\t' read -r s cp hp; do
    [ "$s" = "$session" ] || continue
    [ -n "${http_label[$cp]:-}" ] || continue
    printf '%s\thttp://localhost:%s\n' "${http_label[$cp]}" "$hp"
  done <"$cache_file"
}

# browser_links_for's output flattened to one comma-joined
# "<label>: <url>" line (or "-" if none), same convention as
# container_ports_info_for -- for embedding as a single row field in
# fzf_line_for, where the picker's own preview panes need one flat
# string per field rather than browser_links_for's multi-line output.
browser_links_summary_for() {
  local session="$1" label url parts=()
  while IFS=$'\t' read -r label url; do
    parts+=("${label}: ${url}")
  done < <(browser_links_for "$session")
  if [ "${#parts[@]}" -eq 0 ]; then
    echo "-"
  else
    local IFS=,
    echo "${parts[*]}"
  fi
}

# Always invokes `docker build`, letting Docker's own layer cache keep
# repeat builds fast, rather than hand-rolling a staleness heuristic
# that could miss a file the Dockerfile COPYs.
container_build_if_needed() {
  local image dockerfile
  image="$(container_image_for)"
  dockerfile="$main_worktree_path/$(container_file_path)"
  if [ ! -f "$dockerfile" ]; then
    echo "ruori: container mode: Dockerfile not found at $dockerfile (see 'container-file' in ${CONFIG_FILENAME})" >&2
    return 1
  fi
  echo "ruori: building container image $image" >&2
  docker build -t "$image" -f "$dockerfile" "$main_worktree_path"
}

# New state file, same convention as the other per-repo caches below
# (keyed on the common git dir): one line per
# "<session_name>\t<container_port>\t<host_port>".
ports_cache_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/ports' "$state_dir"
}

CONTAINER_PORT_BASE=20000
CONTAINER_PORT_RANGE=10000

# Best-effort: true if something is already listening on 127.0.0.1:$1.
# Silently reports "not in use" if `lsof` isn't installed — this is only
# an extra safety check on top of allocate_port_for's own bookkeeping,
# not something worth adding a hard dependency for.
port_in_use() {
  command -v lsof >/dev/null 2>&1 || return 1
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

# Deterministic starting point for a (session, container_port) pair's
# port scan, derived from a hash of both rather than always the same
# fixed base. This is what actually keeps different *repos* out of each
# other's way: the ports cache is per-repo (see ports_cache_file), so
# nothing here knows about another repo's allocations directly — without
# this, every repo's first container-port allocation would start
# scanning from the exact same number, clustering everyone at the low
# end of the range and making it likely that a *stopped* container's
# already-baked-in host port (never re-verified on `docker start` — see
# container_start_if_needed) gets silently claimed by an unrelated repo
# in the meantime, so restarting the first one later fails with Docker's
# own "port is already allocated". Seeding from identity spreads
# allocations across the whole range instead, so that only matters if
# two different worktrees happen to hash to the same seed *and* both are
# live at the same moment — rare rather than the common case. It doesn't
# make the race impossible, just unlikely; see docs/container-sandbox-plan.md.
port_seed_for() {
  local hash
  hash="$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
  printf '%s' "$((CONTAINER_PORT_BASE + hash % CONTAINER_PORT_RANGE))"
}

# Reuses an existing row for this (session, container_port) pair if
# present (idempotent across `ruori` restarts and container stop/start);
# otherwise scans forward from port_seed_for's hash-derived starting
# point for the first port that's both unused in this repo's own cache
# and not actually bound on the host, appends a new row, and returns it.
allocate_port_for() {
  local session="$1" container_port="$2" cache_file s cp hp candidate
  cache_file="$(ports_cache_file)" || return 1

  if [ -f "$cache_file" ]; then
    log_file_read "$cache_file"
    while IFS=$'\t' read -r s cp hp; do
      if [ "$s" = "$session" ] && [ "$cp" = "$container_port" ]; then
        printf '%s' "$hp"
        return 0
      fi
    done <"$cache_file"
  fi

  local -A used_host_ports=()
  if [ -f "$cache_file" ]; then
    log_file_read "$cache_file"
    while IFS=$'\t' read -r s cp hp; do
      [ -n "$hp" ] && used_host_ports["$hp"]=1
    done <"$cache_file"
  fi

  candidate="$(port_seed_for "${session}:${container_port}")"
  while [ -n "${used_host_ports[$candidate]:-}" ] || port_in_use "$candidate"; do
    candidate=$((candidate + 1))
  done

  log_file_write "$cache_file"
  printf '%s\t%s\t%s\n' "$session" "$container_port" "$candidate" >>"$cache_file"
  printf '%s' "$candidate"
}

# Strips every row for $1 (a session name) from the ports state file —
# called from teardown (`ruori rm` / the Enter menu's "delete worktree")
# so freed ports aren't shown as allocated by `ruori ports` or reused by
# a later, unrelated worktree.
release_ports_for() {
  local session="$1" cache_file tmp
  cache_file="$(ports_cache_file)" || return 0
  [ -f "$cache_file" ] || return 0
  tmp="$(mktemp -t ruori-ports)"
  log_file_read "$cache_file"
  grep -v "^${session}	" "$cache_file" >"$tmp" 2>/dev/null || true
  log_file_write "$cache_file"
  mv "$tmp" "$cache_file"
}

# Starts one `socat` TCP relay inside container $1 per configured
# container-host-port, so a process in the container that dials
# localhost:<port> transparently reaches host.docker.internal:<port> on
# the host — e.g. a docker-compose-managed database the dev container
# can't run itself (see docs/container-sandbox-guide.md's "Current
# limitation: shared backing services"). Docker only has a flag for the
# opposite direction (`-p`, publishing a *container* port to the host);
# there's no equivalent for publishing a *host* port onto the
# container's own loopback, so this runs as an ordinary background
# process inside the container instead, requiring `socat` in the
# container image. `docker stop` kills every process in a container,
# forwarders included, so container_start_if_needed below calls this
# fresh on every transition to running (both "just created" and
# "docker start after a stop") rather than once ever.
container_start_host_port_forwards() {
  local name="$1" port
  while IFS= read -r port; do
    [ -n "$port" ] || continue
    if ! docker exec "$name" sh -c 'command -v socat' >/dev/null 2>&1; then
      echo "ruori: container-host-port $port: 'socat' not found in container image, skipping (install it via $(container_file_path))" >&2
      continue
    fi
    docker exec -d "$name" socat "TCP-LISTEN:${port},fork,reuseaddr" "TCP:host.docker.internal:${port}"
  done < <(container_host_ports)
}

# running -> no-op; stopped -> `docker start`; absent -> build-if-needed
# then `docker run -d ... sleep infinity` (a durable PID 1; tmux
# sessions live inside via `docker exec`, never as the container's main
# process) with the worktree + git common dir bind-mounted at matching
# host paths, one -v per configured container-volume shadowing a subpath
# of the worktree mount with its own native Docker volume, and one -p/-e
# pair per configured container-port. Copy-in
# (container-copy) only ever runs in the "container just created"
# branch — a stopped-then-restarted container is never re-copied into,
# which is what makes "delete the container to refresh its copied
# config" a meaningful, predictable action. container-host-port
# forwards (see container_start_host_port_forwards above), by contrast,
# are (re)started on every transition to running, since `docker stop`
# kills them along with everything else in the container.
container_start_if_needed() {
  local session="$1" path="$2" common_dir
  # Separate statement: within one `local a=... b=$a` command, bash
  # expands every RHS (including `$a`) *before* any of the assignments
  # take effect, so `$session` here would still see whatever `session`
  # was in the caller's scope (unset, under `set -u`) rather than $1.
  local name="$session"

  container_running "$name" && return 0

  if container_exists "$name"; then
    docker start "$name" >/dev/null
    container_start_host_port_forwards "$name"
    return 0
  fi

  common_dir="$(git_common_dir)" || { echo "ruori: container mode: could not resolve git common dir" >&2; return 1; }
  container_build_if_needed || return 1

  local -a port_flags=()
  local container_port port_name host_port env_name
  while IFS=$'\t' read -r container_port port_name _; do
    [ -n "$container_port" ] || continue
    host_port="$(allocate_port_for "$name" "$container_port")"
    env_name="${port_name:-PORT_${container_port}}"
    port_flags+=(-p "127.0.0.1:${host_port}:${container_port}" -e "${env_name}=${host_port}")
  done < <(container_ports)

  # One -v flag per `container-volume` directive, shadowing that
  # subpath of the worktree bind mount below with a Docker-managed
  # volume on the container's own native storage -- Docker layers a
  # more-specific mount over a broader one regardless of flag order, so
  # this works whether it's listed before or after "-v $path:$path".
  # See container_volume_name_for for the naming scheme.
  local -a native_volume_flags=()
  local relpath volname
  while IFS= read -r relpath; do
    [ -n "$relpath" ] || continue
    volname="$(container_volume_name_for "$name" "$relpath")"
    native_volume_flags+=(-v "$volname:$path/$relpath")
  done < <(container_native_volumes)

  # One -v flag per `container-overlay` directive, bind-mounting that
  # one generated (patched) file over the matching path inside the
  # container only -- the host's real file at that path is never
  # touched. The generated file must exist on disk before `docker run`,
  # since Docker creates an empty directory at a bind-mount source path
  # that doesn't exist yet, which would break a file-to-file mount.
  #
  # Deliberately generated ONLY here (at creation/rebuild), never
  # refreshed for an already-running container: on Docker Desktop for
  # Mac, a single-file bind mount's size gets cached at mount time, and
  # a later host-side write that GROWS the file is served truncated back
  # to that original size (confirmed empirically -- shrinking or
  # same-size rewrites propagate live and correctly; growth silently
  # doesn't, no error, no cache invalidation, even from a brand-new
  # `docker exec`). Writing the file once, before the mount exists, means
  # the mount's very first observed size already is its final one, so
  # this bug never triggers. See docs/gimmicks.md.
  local -a overlay_flags=()
  local ov_relpath ov_patchrel ov_generated
  while IFS=$'\t' read -r ov_relpath ov_patchrel; do
    [ -n "$ov_relpath" ] || continue
    if container_overlay_refresh_one "$name" "$path" "$ov_relpath" "$ov_patchrel"; then
      ov_generated="$(container_overlay_generated_file_for "$name" "$ov_relpath")"
      overlay_flags+=(-v "$ov_generated:$path/$ov_relpath:ro")
    else
      echo "ruori: warning: container-overlay for $ov_relpath failed to generate; container will see the unmodified host file at that path instead -- see $(overlay_log_file 2>/dev/null || echo '<log file>')" >&2
    fi
  done < <(container_overlay_entries)

  # RUORI_SHARED_DIR tells the image's own entrypoint/Dockerfile where
  # this repo's shared, writable, cross-worktree storage lives inside
  # the container -- today that's a subdirectory of the common git dir
  # (already bind-mounted above), created on demand by whatever first
  # writes under it, but the env var is named for what it's *for*, not
  # how it's implemented, so a repo's image can depend on it without
  # caring if that changes later. Lives under ruori's own state
  # subdirectory (see ruori_state_dir) rather than loose in the common
  # dir, so it's cleared right along with the rest of ruori's state by
  # the same `rm -rf`. Useful for anything that should persist or stay
  # in sync across every worktree's container for this repo (e.g. a
  # live-shared auth credential -- see docs/container-sandbox-guide.md's
  # "Recipe: Claude Code auth").
  echo "ruori: creating container $name" >&2
  docker run -d --name "$name" \
    -v "$path:$path" \
    -v "$common_dir:$common_dir" \
    "${native_volume_flags[@]}" \
    "${overlay_flags[@]}" \
    -e "RUORI_SHARED_DIR=$common_dir/ruori/shared" \
    "${port_flags[@]}" \
    "$(container_image_for)" sleep infinity >/dev/null

  container_start_host_port_forwards "$name"

  local host_path container_path
  while IFS=$'\t' read -r host_path container_path; do
    [ -n "$host_path" ] || continue
    if [ -e "$host_path" ]; then
      # docker cp fails outright ("Could not find the file <parent> in
      # container") if container_path's parent directory doesn't already
      # exist in the image -- unlike `cp -T`, it never creates missing
      # intermediate directories on the destination side.
      docker exec "$name" mkdir -p "$(dirname "$container_path")"
      if [ -d "$host_path" ]; then
        # A bare directory SRC_PATH nests itself inside an existing
        # DST_PATH directory (docker cp's default "copy the directory
        # into" behavior) instead of landing its *contents* at
        # container_path as the "<host-path>:<container-path>" directive
        # promises. The trailing "/." tells docker cp to copy the
        # source directory's contents, not the directory itself.
        docker cp "$host_path/." "$name:$container_path"
      else
        docker cp "$host_path" "$name:$container_path"
      fi
    else
      echo "ruori: container-copy: host path not found, skipping: $host_path" >&2
    fi
  done < <(container_copy_entries)
}

# Deletes and recreates the container for session $1 rooted at worktree
# path $2 (see issue #12) — `docker rm -f` followed by
# container_start_if_needed, whose "container just created" branch
# re-runs `docker build` (picking up any Dockerfile change via Docker's
# own layer cache) and container-copy. That's the "delete the container
# to refresh its copied config" action container_start_if_needed's own
# comment already calls out, just as a command instead of a manual
# `docker rm -f`. Doesn't touch allocate_port_for's cache (so a rebuilt
# container keeps the same host port mappings) or any container-volume
# native volumes (data there survives, same as a plain `docker start`
# would leave it) — only the container object itself is disposable
# here; see delete_worktree for the full-teardown path that does remove
# ports/volumes. Confirms interactively first, like delete_worktree,
# since it discards whatever state lived only inside the old container.
rebuild_container_for() {
  local session="$1" path="$2" confirm
  echo "About to rebuild container:"
  echo "  session: $session"
  echo "  this deletes the existing container and recreates it (image"
  echo "  rebuild + container-copy); ports and container-volume data are"
  echo "  kept."
  read -r -p "Rebuild this container? [y/N] " confirm
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) echo "ruori: aborted, container not rebuilt"; return 1 ;;
  esac

  docker rm -f "$session" >/dev/null 2>&1 || true
  container_start_if_needed "$session" "$path"
}

# True if a tmux session named $2 exists — checked inside the named
# container via `docker exec` when $1 (use_container) is "1", or on the
# host tmux server directly (today's behavior) otherwise. Container mode
# is opt-in per repo (never per worktree), so callers always pass the
# single repo-wide $CONTAINER_MODE flag here.
tmux_has_session() {
  local use_container="$1" session="$2"
  if [ "$use_container" = "1" ]; then
    docker exec "$session" tmux has-session -t "$session" 2>/dev/null
  else
    tmux has-session -t "$session" 2>/dev/null
  fi
}

require_docker_if_container_mode() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "ruori: required command 'docker' not found in PATH (needed because ${CONFIG_FILENAME} has 'container on')" >&2
    exit 1
  fi
}

# `patch` is only needed by repos that actually use `container-overlay`
# (see container_overlay_refresh_one), so this is a soft dependency like
# docker above rather than one of the always-required commands checked
# at the top of the script.
require_patch_if_overlay_configured() {
  if ! command -v patch >/dev/null 2>&1; then
    echo "ruori: required command 'patch' not found in PATH (needed because ${CONFIG_FILENAME} has a 'container-overlay' directive)" >&2
    exit 1
  fi
}

# Filename ruori-claude-status-hook (see docs/agent-hooks-setup-guide.md)
# writes at the root of the worktree it's running in — the two sides
# only need to agree on this name, not on any shared central location.
# Lives under one .ruori/ subdirectory (alongside AGENT_USAGE_FILENAME
# below) rather than as a loose dotfile, so a single **global**
# gitignore entry for the directory covers both — see the setup guide.
CLAUDE_STATUS_FILENAME=".ruori/claude-status"

# Same host/container-transparent trick as CLAUDE_STATUS_FILENAME above,
# extended to carry usage data (see docs/container-sandbox-plan.md
# section J): a two-line "<cost_usd>\n<epoch>\n" file at the worktree
# root, written by whatever agent's own hook runs there — inside a
# container in container mode, this bind-mounted path is the only
# reliable way for the host-side USAGE column to see it, since
# ~/.claude/projects lives inside the container's own filesystem and is
# never live-mounted. Generic, agent-owned extension point: `ruori` reads
# it without knowing (or caring) which agent wrote it.
AGENT_USAGE_FILENAME=".ruori/agent-usage"

# How stale an AGENT_USAGE_FILENAME reading can be before usage_cost_for
# ignores it and falls back to the host-side jsonl scan instead — guards
# against showing a frozen number from a long-abandoned container/hook
# setup as if it were still live. 30 days, generous on purpose: this
# file is only ever a stand-in for the host scan, not a replacement for
# it, so a rare stale read just means one worktree briefly shows the
# host-side value instead.
AGENT_USAGE_STALE_SECS=$((30 * 24 * 60 * 60))

# "busy"/"idle" from the most recent hook event for this worktree, or
# "-" if the hook has never fired for it (not configured, or no Claude
# Code session has run there since the hook was set up). Only makes
# sense while a tmux session is actually alive for that worktree, so
# callers should gate on that themselves (a killed session can leave a
# stale "busy"/"idle" file behind — this function doesn't know that).
claude_status_for() {
  local path="$1" f
  f="$path/$CLAUDE_STATUS_FILENAME"
  if [ -f "$f" ]; then
    log_file_read "$f"
    head -n1 "$f"
  else
    echo "-"
  fi
}

# Maps branch name -> PR status string. Populated either from the on-disk
# cache (load_pr_status_cache — instant, used on every draw/reload) or
# freshly from `gh` (fetch_pr_statuses — slow, one or more network calls,
# only triggered by Ctrl-F; see below). A branch with no entry shows as
# "-" (fetched at least once, just no PR for this branch) or "?" (never
# fetched at all — see pr_status_ever_fetched) wherever it's read.
declare -A pr_status_map

# Whether a PR-status fetch has ever completed for this repo (this
# machine, ever — not just this process): true as soon as either the
# on-disk cache file exists (load_pr_status_cache found one) or a fetch
# just ran (fetch_pr_statuses always ends by writing the cache file, so
# it's true regardless of whether the fetch itself actually found
# anything). Lets pr_status_for tell "no PR" apart from "no one's
# checked yet" instead of showing "-" for both.
pr_status_ever_fetched=0

# Each `reload(bash ruori __fzfgen...)` binding runs in a brand-new bash
# process (fzf shells out), so pr_status_map can't just live in memory
# between reloads the way it does across the manager's own while-loop
# iterations — it has to round-trip through a file. Cached under the
# repo's *common* git dir (not the worktree-specific one) so every
# worktree of this repo shares one PR-status cache, keyed on branch name.
pr_status_cache_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/pr-status.cache' "$state_dir"
}

save_pr_status_cache() {
  local cache_file branch
  cache_file="$(pr_status_cache_file)" || return 0
  log_file_write "$cache_file"
  : >"$cache_file"
  for branch in "${!pr_status_map[@]}"; do
    printf '%s\t%s\n' "$branch" "${pr_status_map[$branch]}" >>"$cache_file"
  done
}

# Fast, no network: loads whatever fetch_pr_statuses last wrote to disk
# (empty/missing cache just means every branch reads as "-"). Called on
# every picker draw/reload so the PR column always reflects the last
# Ctrl-F fetch instead of resetting each time.
load_pr_status_cache() {
  pr_status_map=()
  pr_status_ever_fetched=0
  local cache_file branch status
  cache_file="$(pr_status_cache_file)" || return 0
  [ -f "$cache_file" ] || return 0
  pr_status_ever_fetched=1
  log_file_read "$cache_file"
  while IFS=$'\t' read -r branch status; do
    [ -n "$branch" ] || continue
    pr_status_map["$branch"]="$status"
  done <"$cache_file"
}

# Rank of each pr_status_for value, highest first — used only to resolve
# the rare case of a branch matching more than one PR (e.g. a merged PR
# whose branch got reused for a new one): the highest-ranked match wins,
# regardless of which one `gh pr list` happened to return first. Open,
# actionable states outrank merged, which outranks closed-without-merge.
pr_status_rank() {
  case "$1" in
    unresolved) echo 5 ;;
    changes) echo 4 ;;
    pending) echo 3 ;;
    approved) echo 3 ;;
    draft) echo 2 ;;
    merged) echo 1 ;;
    closed) echo 0 ;;
    *) echo -1 ;;
  esac
}

# Populates pr_status_map with one `gh pr list --head <branch> --state
# all` call per worktree branch (plus one reviewThreads query per *open,
# non-draft* match, to find unresolved comments — merged/closed PRs skip
# that call entirely, since it's meaningless for them), and persists the
# result via save_pr_status_cache. Deliberately per-branch rather than
# one repo-wide `gh pr list` call: a single call needs a --limit, and on
# an active repo the most-recent-N PRs can fail to include an older
# worktree branch's PR entirely (a merged PR from a few weeks back can
# already be outside the 200 most recent PRs on a busy repo) — silently
# showing "-" instead of "merged" for a perfectly real PR, not just slow.
# Per-branch lookups are always correct regardless of the repo's total PR
# history size, at the cost of more (still cheap, targeted) `gh` calls.
# Slow either way (one or more network round-trips) — only ever called
# from Ctrl-F (__fzfgen_fetch), never from the regular draw/reload path.
# Silently leaves pr_status_map empty on any failure (gh/jq missing, no
# remote, not authenticated, offline, ...) since the PR column is a
# best-effort extra, not something worth failing the picker over.
fetch_pr_statuses() {
  pr_status_map=()
  pr_status_ever_fetched=1
  command -v gh >/dev/null 2>&1 || { save_pr_status_cache; return 0; }
  command -v jq >/dev/null 2>&1 || { save_pr_status_cache; return 0; }

  local repo owner name
  repo="$(cd "$repo_root" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)" || { save_pr_status_cache; return 0; }
  [ -n "$repo" ] || { save_pr_status_cache; return 0; }
  owner="${repo%%/*}"
  name="${repo#*/}"

  local branch pr_json number is_draft review_decision pr_state unresolved status existing
  for branch in "${branches[@]}"; do
    case "$branch" in
      '('*')') continue ;;  # detached worktree placeholder — no real branch to look up a PR for
    esac
    [ -z "${pr_status_map[$branch]:-}" ] || continue  # already resolved (e.g. two worktrees somehow on the same branch)

    pr_json="$(cd "$repo_root" && gh pr list --state all --head "$branch" --json number,isDraft,reviewDecision,state --limit 5 2>/dev/null)" || continue
    [ -n "$pr_json" ] && [ "$pr_json" != "[]" ] || continue

    while IFS=$'\t' read -r number is_draft review_decision pr_state; do
      [ -n "$number" ] || continue
      case "$pr_state" in
        MERGED) status="merged" ;;
        CLOSED) status="closed" ;;
        *)
          if [ "$is_draft" = "true" ]; then
            status="draft"
          else
            unresolved="$(gh api graphql \
              -f query='query($owner:String!,$name:String!,$number:Int!){
                repository(owner:$owner,name:$name){
                  pullRequest(number:$number){
                    reviewThreads(first:100){ nodes { isResolved } }
                  }
                }
              }' -F owner="$owner" -F name="$name" -F number="$number" \
              --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved==false)] | length' \
              2>/dev/null)" || true
            case "$unresolved" in
              ''|*[!0-9]*) unresolved=0 ;;
            esac
            if [ "$unresolved" -gt 0 ]; then
              status="unresolved"
            else
              case "$review_decision" in
                APPROVED) status="approved" ;;
                CHANGES_REQUESTED) status="changes" ;;
                *) status="pending" ;;
              esac
            fi
          fi
          ;;
      esac
      # A branch can (rarely) match more than one PR (e.g. a merged PR
      # whose branch got reused for a new one) — keep the
      # highest-ranked, most-actionable match rather than whichever
      # `gh` happened to list first.
      existing="${pr_status_map[$branch]:-}"
      if [ -z "$existing" ] || [ "$(pr_status_rank "$status")" -gt "$(pr_status_rank "$existing")" ]; then
        pr_status_map["$branch"]="$status"
      fi
    done < <(printf '%s' "$pr_json" | jq -r '.[] | [(.number|tostring), (.isDraft|tostring), (.reviewDecision // ""), .state] | @tsv')
  done

  save_pr_status_cache
}

pr_status_for() {
  local branch="$1" status="${pr_status_map["$1"]:-}"
  [ -n "$status" ] && { printf '%s' "$status"; return 0; }
  [ "$pr_status_ever_fetched" = "1" ] && printf '%s' '-' || printf '%s' '?'
}

# Maps worktree path -> total Claude Code cost in USD (as a plain decimal
# string, e.g. "34.81"), i.e. the same number `/usage` shows, summed
# across every Claude Code session ever run with that path as its cwd.
# Keyed by path rather than branch (unlike pr_status_map) since Claude
# sessions are tied to the worktree's directory, not its branch. Same
# on-disk-cache/fetch split and rationale as pr_status_map — see above —
# except the cost comes from local transcript files (~/.claude/projects),
# not the network, but scanning ALL of a heavy user's Claude Code history
# to find the sessions for these worktrees is still slow enough (all
# session files get scanned once per fetch) to want an explicit trigger
# rather than doing it on every draw/reload.
declare -A usage_cost_map

# Same "never fetched" vs "fetched, no value" distinction as
# pr_status_ever_fetched, for the USAGE column.
usage_cost_ever_fetched=0

usage_cost_cache_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/usage-cost.cache' "$state_dir"
}

save_usage_cost_cache() {
  local cache_file path
  cache_file="$(usage_cost_cache_file)" || return 0
  log_file_write "$cache_file"
  : >"$cache_file"
  for path in "${!usage_cost_map[@]}"; do
    printf '%s\t%s\n' "$path" "${usage_cost_map[$path]}" >>"$cache_file"
  done
}

# Fast, no filesystem scan of ~/.claude: loads whatever fetch_usage_costs
# last wrote to disk. Called on every picker draw/reload, same as
# load_pr_status_cache.
load_usage_cost_cache() {
  usage_cost_map=()
  usage_cost_ever_fetched=0
  local cache_file path cost
  cache_file="$(usage_cost_cache_file)" || return 0
  [ -f "$cache_file" ] || return 0
  usage_cost_ever_fetched=1
  log_file_read "$cache_file"
  while IFS=$'\t' read -r path cost; do
    [ -n "$path" ] || continue
    usage_cost_map["$path"]="$cost"
  done <"$cache_file"
}

# Scans every top-level Claude Code session transcript under both
# ~/.claude/projects (host-mode worktrees) and, for a container-mode
# repo that shares Claude Code's login via RUORI_SHARED_DIR (see
# docs/container-sandbox-guide.md's "Recipe: Claude Code auth"), any
# <ruori-state-dir>/shared/*/projects it finds too -- that immediate
# subdirectory name (e.g. this repo's "ruori-claude-home") is a
# per-repo Dockerfile/entrypoint convention, never ruori's to know, so
# this globs for the *shape* (something directly under
# RUORI_SHARED_DIR with its own projects/ folder) rather than a
# specific name. Deliberately not */subagents/*.jsonl, nested under a
# session: those never carry their own "cost-state" line, since their
# cost is already rolled into the parent session's. Sums each matching
# file's last "cost-state" line's totalCostUSD (that field is already
# a running total for the session, so only the last one per file
# counts) for files whose cwd matches one of this repo's worktree
# paths. Persists via save_usage_cost_cache. Silently skips a scan root
# if `jq` is missing or it doesn't exist (e.g. Claude Code hooks were
# never used, or this repo doesn't share auth this way) — best-effort
# extra, like the PR column.
fetch_usage_costs() {
  usage_cost_map=()
  usage_cost_ever_fetched=1
  command -v jq >/dev/null 2>&1 || { save_usage_cost_cache; return 0; }

  local -a projects_dirs=("$HOME/.claude/projects")
  local state_dir shared_projects_dir
  state_dir="$(ruori_state_dir)" 2>/dev/null || state_dir=""
  if [ -n "$state_dir" ]; then
    for shared_projects_dir in "$state_dir/shared"/*/projects; do
      [ -d "$shared_projects_dir" ] || continue
      projects_dirs+=("$shared_projects_dir")
    done
  fi

  # Fast membership check so we skip the (more expensive) cost extraction
  # for the many session files that belong to other repos entirely.
  local -A wanted_paths=()
  local p
  for p in "${paths[@]}"; do
    wanted_paths["$p"]=1
  done

  # Claude Code names each ~/.claude/projects subdirectory after the
  # cwd its sessions ran in, with every non-alphanumeric character
  # replaced by '-' (e.g. "/Users/me/git/foo" -> "-Users-me-git-foo").
  # This is a *forward* encoding of a cwd we already know (this repo's
  # own worktree paths) — not an attempt to invert an unknown one — so
  # it's safe to use as an exact-match pre-filter: skip a whole
  # directory, and every session transcript inside it, without opening
  # a single file, if its name can't possibly belong to one of this
  # repo's worktrees. On a machine with many repos this is the
  # difference between reading a handful of files and reading every
  # session transcript ever recorded, host-wide, on every `ruori
  # list`/`details`/Ctrl-F fetch.
  local -A wanted_dir_names=()
  for p in "${paths[@]}"; do
    wanted_dir_names["$(printf '%s' "$p" | tr -c 'A-Za-z0-9' '-')"]=1
  done

  local projects_dir f cwd cost dir_name project_subdir

  # Reads $1 (a session transcript jsonl file) and, if its recorded cwd
  # is one of this repo's worktree paths, adds its last cost-state
  # total into usage_cost_map. A local function (bash's dynamic scoping
  # means it sees wanted_paths/usage_cost_map from the enclosing call)
  # so both scan shapes below — filtered and unfiltered — share one
  # implementation.
  scan_usage_cost_file() {
    local f="$1"
    log_file_read "$f"
    # Both greps legitimately return 1 (no match) for plenty of files —
    # e.g. a session with no recorded cwd, or one that ended before any
    # cost-state checkpoint was written — and pipefail would otherwise
    # turn that into a script-ending failure via `set -e` on the
    # assignment itself, before the `[ -n ... ] || continue` below even
    # runs.
    cwd="$(grep -m1 '"cwd":"' "$f" 2>/dev/null | jq -r '.cwd // empty' 2>/dev/null)" || true
    [ -n "$cwd" ] || return 0
    [ -n "${wanted_paths[$cwd]:-}" ] || return 0
    cost="$(grep '"type":"cost-state"' "$f" 2>/dev/null | tail -1 | jq -r '.totalCostUSD // empty' 2>/dev/null)" || true
    [ -n "$cost" ] || return 0
    usage_cost_map["$cwd"]="$(printf '%s\n%s\n' "${usage_cost_map[$cwd]:-0}" "$cost" | jq -s 'add')"
  }

  for projects_dir in "${projects_dirs[@]}"; do
    [ -d "$projects_dir" ] || continue
    if [ "$projects_dir" = "$HOME/.claude/projects" ]; then
      # The directory-name pre-filter only applies here: a host-mode
      # session's recorded cwd is guaranteed to be the worktree path it
      # ran in (see activate_worktree's `tmux new-session -c
      # "$target_path"`). A container-mode session's cwd is NOT
      # guaranteed to equal the host worktree path it's bind-mounted at
      # — e.g. a Dockerfile whose entrypoint runs Claude Code from a
      # fixed WORKDIR instead of cd-ing into the mount — so applying
      # this same shortcut to the RUORI_SHARED_DIR scan below would
      # risk silently skipping real matches; that one still scans every
      # file, same as before.
      for project_subdir in "$projects_dir"/*/; do
        [ -d "$project_subdir" ] || continue
        dir_name="$(basename "$project_subdir")"
        [ -n "${wanted_dir_names[$dir_name]:-}" ] || continue
        for f in "$project_subdir"*.jsonl; do
          [ -f "$f" ] || continue
          scan_usage_cost_file "$f"
        done
      done
      continue
    fi
    for f in "$projects_dir"/*/*.jsonl; do
      [ -f "$f" ] || continue
      scan_usage_cost_file "$f"
    done
  done

  save_usage_cost_cache
}

usage_cost_for() {
  local path="$1" cost f agent_cost agent_epoch now
  f="$path/$AGENT_USAGE_FILENAME"
  if [ -f "$f" ]; then
    log_file_read "$f"
    agent_cost="$(sed -n '1p' "$f" 2>/dev/null)"
    agent_epoch="$(sed -n '2p' "$f" 2>/dev/null)"
    now="$(date +%s)"
    case "$agent_epoch" in
      ''|*[!0-9]*) agent_epoch="" ;;
    esac
    if [ -n "$agent_cost" ] && [ -n "$agent_epoch" ] && [ $((now - agent_epoch)) -lt "$AGENT_USAGE_STALE_SECS" ]; then
      LC_NUMERIC=C printf '$%.2f' "$agent_cost" 2>/dev/null && return 0
    fi
  fi

  cost="${usage_cost_map["$path"]:-}"
  if [ -z "$cost" ]; then
    [ "$usage_cost_ever_fetched" = "1" ] && printf '%s' '-' || printf '%s' '?'
    return 0
  fi
  # LC_NUMERIC=C: bash's printf %f is locale-sensitive and jq always
  # emits a '.' decimal point — under a locale that expects ',' (e.g.
  # fi_FI.UTF-8), plain `printf %.2f` on a '.'-separated value fails
  # ("invalid number") and, under this script's `set -e`, would abort
  # the whole picker.
  LC_NUMERIC=C printf '$%.2f' "$cost"
}

# "*" for the row matching current_worktree_path (see its definition
# above — the main worktree by default, or the last one you switched to),
# " " for every other row.
marker_for() {
  [ "$1" = "$current_worktree_path" ] && printf '*' || printf ' '
}

# Marks that the user has explicitly said host mode is fine for this
# repo, via `ruori --host-mode-fine` (see the flag-stripping code before
# command dispatch below). Repo-scoped, not per-worktree -- same as
# CONTAINER_MODE itself, container mode is opt-in per repo -- so
# acknowledging once silences the nudge for every worktree of this repo.
host_mode_ack_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/host-mode-ack' "$state_dir"
}

# Persists current_worktree_path across separate runs of `ruori` — without
# this, a brand-new process always defaults back to the main worktree
# (see the "must be run from the main worktree" check above), forgetting
# whatever you'd last switched to in a previous run. Cached under the
# repo's common git dir, like the PR/usage caches.
current_worktree_cache_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/current-worktree' "$state_dir"
}

save_current_worktree() {
  local cache_file
  cache_file="$(current_worktree_cache_file)" || return 0
  log_file_write "$cache_file"
  printf '%s\n' "$current_worktree_path" >"$cache_file"
}

# Overrides current_worktree_path with whatever was last persisted, as
# long as that worktree still exists (falls back to the default — the
# main worktree — if there's no cache yet, or the persisted worktree was
# since removed, e.g. via `ruori rm`).
load_current_worktree() {
  local cache_file persisted p
  cache_file="$(current_worktree_cache_file)" || return 0
  [ -f "$cache_file" ] || return 0
  log_file_read "$cache_file"
  persisted="$(head -n1 "$cache_file")"
  [ -n "$persisted" ] || return 0
  for p in "${paths[@]}"; do
    if [ "$p" = "$persisted" ]; then
      current_worktree_path="$persisted"
      return 0
    fi
  done
}

MARKER_COL_WIDTH=1
BRANCH_COL_WIDTH=56
TMUX_COL_WIDTH=8
CLAUDE_COL_WIDTH=8
PR_COL_WIDTH=10
USAGE_COL_WIDTH=9

# Pad to a fixed width, truncating with "..." instead of just letting a
# long value overflow and push every later column to the right.
truncate_pad() {
  local s="$1" width="$2"
  if [ "${#s}" -gt "$width" ]; then
    printf '%s' "${s:0:$((width - 3))}..."
  else
    printf '%-*s' "$width" "$s"
  fi
}

# One line per worktree: idx<TAB>current-marker<TAB>state-status<TAB>
# claude-status<TAB>pr-status<TAB>usage-cost<TAB>branch<TAB>path<TAB>
# session<TAB>raw-branch<TAB>image-info<TAB>ports-info<TAB>id-info<TAB>
# browser-links-summary. Only marker/state/claude/pr/usage/branch are
# shown in the picker; the rest are available to its preview window,
# and to the Enter action menu via the selected row's own fields (see
# the manager loop below) regardless of what --with-nth displays.
# Shared by `ruori list`, the interactive picker, and the picker's own
# reload (so a session killed via the Enter menu's "kill
# tmux"/"stop container" is reflected immediately).
#
# The state column (and header, see fzf_header_line) doubles as tmux
# activity in normal mode and container state in container mode — a
# session can only be "active" via `docker exec` into a running
# container anyway, so container state is the more informative of the
# two once containers are involved, and it's what the Enter menu's
# "stop container" there actually changes.
fzf_line_for() {
  local i="$1" session active claude pr usage state image_info ports_info id_info url_info
  session="$(session_name_for "${branches[$i]}" "${paths[$i]}")"
  if [ "$CONTAINER_MODE" = "1" ]; then
    # container_state_for first: a stopped/never-created container can't
    # have a tmux session inside it, so `docker exec ... tmux
    # has-session` (tmux_has_session's container-mode path) would just
    # fail anyway — skip that extra round-trip to the Docker daemon
    # unless the container is actually running.
    state="$(container_state_for "$session")"
    if [ "$state" = "running" ] && tmux_has_session "$CONTAINER_MODE" "$session"; then
      active="active"
      claude="$(claude_status_for "${paths[$i]}")"
    else
      active="-"
      claude="-"
    fi
    image_info="$(container_image_info_for)"
    ports_info="$(container_ports_info_for "$session")"
    id_info="$(container_id_for "$session")"
    url_info="$(browser_links_summary_for "$session")"
  else
    if tmux_has_session "$CONTAINER_MODE" "$session"; then
      active="active"
      claude="$(claude_status_for "${paths[$i]}")"
    else
      active="-"
      claude="-"
    fi
    state="$active"
    image_info="-"
    ports_info="-"
    id_info="-"
    url_info="-"
  fi
  pr="$(pr_status_for "${branches[$i]}")"
  usage="$(usage_cost_for "${paths[$i]}")"

  # Branch column colored to match this session's tmux status-bar color
  # (see container_color_for/activate_worktree) so the picker and the
  # attached terminal carry the same per-container visual cue (issue
  # #30) -- padded first so the invisible SGR bytes never throw off the
  # column's fixed on-screen width; wrapped around the already-padded
  # string keeps that width intact under --ansi, which fzf strips
  # before measuring. No color at all when container mode is off, per
  # the issue's ask.
  local branch_field
  branch_field="$(truncate_pad "${branches[$i]}" "$BRANCH_COL_WIDTH")"
  if [ "$CONTAINER_MODE" = "1" ]; then
    branch_field=$'\033[38;5;'"$(container_color_for "$session")"'m'"${branch_field}"$'\033[0m'
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$i" \
    "$(marker_for "${paths[$i]}")" \
    "$(truncate_pad "$state" "$TMUX_COL_WIDTH")" \
    "$(truncate_pad "$claude" "$CLAUDE_COL_WIDTH")" \
    "$(truncate_pad "$pr" "$PR_COL_WIDTH")" \
    "$(truncate_pad "$usage" "$USAGE_COL_WIDTH")" \
    "$branch_field" \
    "${paths[$i]}" "$session" "${branches[$i]}" "$image_info" "$ports_info" "$id_info" "$url_info"
}

# The picker's own pinned column-header row (used with --header-lines=1),
# in the same tab-delimited shape as fzf_line_for's output so --with-nth
# picks it apart the same way. The state column's label follows
# CONTAINER_MODE the same way its value does (see fzf_line_for).
fzf_header_line() {
  local state_label="TMUX"
  [ "$CONTAINER_MODE" = "1" ] && state_label="DOCKER"
  printf '\t%-*s\t%-*s\t%-*s\t%-*s\t%-*s\t%-*s\t\t\t\t\t\t\t\n' \
    "$MARKER_COL_WIDTH" "" \
    "$TMUX_COL_WIDTH" "$state_label" "$CLAUDE_COL_WIDTH" "CLAUDE" "$PR_COL_WIDTH" "PR" \
    "$USAGE_COL_WIDTH" "USAGE" "$BRANCH_COL_WIDTH" "BRANCH"
}

# Deletes one worktree and everything ruori itself created for it: kills its
# tmux session (if any), removes the worktree via `git worktree remove`
# (falling back to --force, with confirmation, if git refuses because of
# uncommitted/untracked changes), optionally deletes the local branch, and
# drops any cached PR status for that branch. Interactive — always
# confirms before doing anything destructive, since removing a worktree
# can discard uncommitted work. Refuses to touch the main worktree (git
# can't remove that one anyway; it's not a "worktree" you'd delete).
delete_worktree() {
  local path="$1" branch="$2" session="$3" confirm

  if [ "$path" = "$main_worktree_path" ]; then
    echo "ruori: refusing to delete the main worktree ($path)" >&2
    return 1
  fi

  echo "About to delete worktree:"
  echo "  branch: $branch"
  echo "  path:   $path"
  if tmux_has_session "$CONTAINER_MODE" "$session"; then
    echo "  tmux:   session '$session' is active and will be killed"
  fi
  read -r -p "Delete this worktree? [y/N] " confirm
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) echo "ruori: aborted, nothing deleted"; return 1 ;;
  esac

  tmux kill-session -t "$session" 2>/dev/null || true

  if [ "$CONTAINER_MODE" = "1" ]; then
    docker rm -f "$session" 2>/dev/null || true
    release_ports_for "$session"
    # By name prefix, not by re-reading the current container-volume
    # directives -- a volume created under a directive since edited or
    # removed from .ruori.conf still gets cleaned up here, same as
    # `docker rm -f` above doesn't care whether "container on" is still
    # set.
    local vol
    while IFS= read -r vol; do
      [ -n "$vol" ] || continue
      docker volume rm "$vol" 2>/dev/null || true
    done < <(docker volume ls -q --filter "name=^${session}__vol-" 2>/dev/null)
  fi

  local rm_err
  rm_err="$(mktemp -t ruori-rm-err)"
  log_file_write "$rm_err"
  if ! git -C "$repo_root" worktree remove "$path" 2>"$rm_err"; then
    echo "ruori: git worktree remove failed:" >&2
    log_file_read "$rm_err"
    sed 's/^/  /' "$rm_err" >&2
    rm -f "$rm_err"
    read -r -p "Force removal? This discards any uncommitted/untracked changes in that worktree. [y/N] " confirm
    case "$confirm" in
      y|Y|yes|YES)
        if ! git -C "$repo_root" worktree remove --force "$path"; then
          echo "ruori: git worktree remove --force also failed; nothing further attempted" >&2
          return 1
        fi
        ;;
      *)
        echo "ruori: not removed"
        return 1
        ;;
    esac
  else
    rm -f "$rm_err"
  fi

  case "$branch" in
    '('*')') ;;  # detached worktree placeholder like "(detached@abcd1234)" — no real branch to offer deleting
    *)
      read -r -p "Also delete local branch '$branch'? [y/N] " confirm
      case "$confirm" in
        y|Y|yes|YES)
          git -C "$repo_root" branch -D "$branch" 2>&1 | sed 's/^/ruori: /' || true
          ;;
      esac
      ;;
  esac

  # Best-effort: drop this branch's cached PR status so a later reload
  # doesn't keep showing stale data for a branch that no longer exists.
  local cache_file tmp_cache
  cache_file="$(pr_status_cache_file)" && [ -f "$cache_file" ] && {
    tmp_cache="$(mktemp -t ruori-pr-cache)"
    log_file_read "$cache_file"
    grep -v "^${branch}	" "$cache_file" >"$tmp_cache" 2>/dev/null || true
    log_file_write "$cache_file"
    mv "$tmp_cache" "$cache_file"
  }

  echo "ruori: deleted worktree for '$branch'"
}

# Creates a worktree for $1 (an existing or brand-new branch), optionally
# from start-point $2 (only used for a brand-new branch; default HEAD).
# Sets $created_worktree_path and returns 0 on success; prints an error
# and returns 1 otherwise. Shared by the 'new' command and the picker's
# Ctrl-N prompt (__new_prompt below).
create_worktree_for_branch() {
  local branch_arg="$1" start_point="${2:-}"
  local new_worktree_root new_path

  for i in "${!paths[@]}"; do
    if [ "${branches[$i]}" = "$branch_arg" ]; then
      echo "ruori: worktree for branch '$branch_arg' already exists at ${paths[$i]} (see 'ruori list')" >&2
      return 1
    fi
  done

  # Sibling of the main worktree, never nested inside it — a worktree
  # nested under the main tree risks tools/scanners that walk the main
  # tree (build steps, editors, `find`) picking up its contents too.
  new_worktree_root="$(dirname "$main_worktree_path")/${repo_name}.worktrees"
  # Flattened, not `$new_worktree_root/$branch_arg` verbatim: a worktree
  # path is independent of the branch's own ref name (git is fine with a
  # "feat/x" branch checked out at any directory), so a slash in the
  # branch name would otherwise nest it (.worktrees/feat/x) — leaving an
  # empty "feat/" behind once that worktree is later removed (nothing
  # here cleans up now-empty parent dirs), and making a shell prompt
  # that shows both "current dir" and "current branch" redundantly print
  # something like "x on feat/x" instead of "feat-x on feat/x".
  new_path="$new_worktree_root/$(printf '%s' "$branch_arg" | tr '/' '-')"
  if [ -e "$new_path" ]; then
    echo "ruori: refusing to create worktree: $new_path already exists" >&2
    return 1
  fi
  mkdir -p "$(dirname "$new_path")"

  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch_arg"; then
    if [ -n "$start_point" ]; then
      echo "ruori: branch '$branch_arg' already exists; ignoring start-point '$start_point'" >&2
    fi
    if ! git -C "$repo_root" worktree add "$new_path" "$branch_arg"; then
      return 1
    fi
  else
    if ! git -C "$repo_root" worktree add -b "$branch_arg" "$new_path" "${start_point:-HEAD}"; then
      return 1
    fi
  fi

  echo "ruori: created worktree for '$branch_arg' at $new_path"
  created_worktree_path="$new_path"
}

# Computed once, not per-picker-iteration: container mode is opt-in per
# repo, never per worktree, so this one flag governs every code path
# below (main loop, iTerm2 attach, ruori rm, the picker's TMUX column) for
# the whole run. A repo with no `container on` directive gets
# CONTAINER_MODE=0 and is byte-identical to today (see decision I).
warn_unknown_directives
CONTAINER_MODE=0
container_mode_enabled && CONTAINER_MODE=1
[ "$CONTAINER_MODE" = "1" ] && require_docker_if_container_mode
[ "$CONTAINER_MODE" = "1" ] && [ -n "$(container_overlay_entries)" ] && require_patch_if_overlay_configured

# Primes _container_image_info_cache in this process (not a subshell —
# same reasoning as git_common_dir_prime/config_directives_prime
# above), since every caller in fzf_line_for's per-worktree-row loop
# invokes container_image_info_for through `$(...)`.
[ "$CONTAINER_MODE" = "1" ] && { container_image_info_for >/dev/null 2>&1 || true; }

# --host-mode-fine: a one-time, per-repo way to permanently silence the
# "container mode is off" nudge further below, for a user who's
# deliberately decided host mode is fine for this repo. Not a normal
# subcommand -- it can appear anywhere in the arguments to any other
# command ('ruori --host-mode-fine', 'ruori new foo --host-mode-fine',
# ...) -- so it's stripped out of the positional params here, before
# `cmd` is ever read, rather than added as another case branch below.
host_mode_ack_requested=0
host_mode_fine_args=()
for host_mode_fine_arg in "$@"; do
  if [ "$host_mode_fine_arg" = "--host-mode-fine" ]; then
    host_mode_ack_requested=1
  else
    host_mode_fine_args+=("$host_mode_fine_arg")
  fi
done
set -- "${host_mode_fine_args[@]}"
if [ "$host_mode_ack_requested" = "1" ]; then
  host_mode_ack_file_path="$(host_mode_ack_file)" || host_mode_ack_file_path=""
  if [ -n "$host_mode_ack_file_path" ]; then
    log_file_write "$host_mode_ack_file_path"
    date '+%Y-%m-%d %H:%M:%S' >"$host_mode_ack_file_path"
  fi
fi

load_current_worktree

cmd="${1:-switch}"

# Set by the 'new' case below when a fresh worktree should be activated
# (tmux/container started, VS Code + iTerm2 opened) the moment the manager
# loop starts, without waiting for it to be fzf-picked first.
pending_activate_path=""
pending_activate_branch=""

case "$cmd" in
  init)
    # Resolves the ruori checkout `bin/ruori` was symlinked from
    # (the README's own install step: `ln -s .../bin/ruori ~/.local/bin/ruori`)
    # so the docs copied below come from the real README.md/docs/ sitting
    # next to it, rather than a second copy baked into this script that
    # could drift out of sync.
    # Manual symlink-chain resolution, not `readlink -f` (missing on some
    # macOS/BSD `readlink`s) — BASH_SOURCE[0], not $0, since $0 is just
    # whatever name this script was invoked as (e.g. `ruori`, if found via
    # PATH), while BASH_SOURCE[0] is this file's own path regardless.
    ruori_src="${BASH_SOURCE[0]}"
    while [ -L "$ruori_src" ]; do
      ruori_src_dir="$(cd -P "$(dirname "$ruori_src")" && pwd)"
      ruori_src="$(readlink "$ruori_src")"
      case "$ruori_src" in
        /*) ;;
        *) ruori_src="$ruori_src_dir/$ruori_src" ;;
      esac
    done
    ruori_root="$(dirname "$(cd -P "$(dirname "$ruori_src")" && pwd)")"
    readme_src="$ruori_root/README.md"
    docs_src="$ruori_root/docs"
    if [ ! -f "$readme_src" ] || [ ! -d "$docs_src" ]; then
      echo "ruori: init: can't find $readme_src / $docs_src" >&2
      echo "ruori: init: is 'ruori' still a symlink into a ruori checkout? (see README.md 'Install')" >&2
      exit 1
    fi

    # Copied into ruori's own state dir rather than committed into the
    # repo (e.g. as a Claude-Code-specific skill file) so this works with
    # whatever coding agent the user has, and needs no git add/commit --
    # they're throwaway once an agent has acted on them. The whole doc
    # set is copied, not just the setup guide, since there's no separate
    # agent-only doc: an agent reading these is just another reader of
    # the same docs a human would use, and may need the extra context
    # (config-file.md, container-sandbox-guide.md, ...) the guide itself
    # links out to.
    state_dir="$(ruori_state_dir)" || exit 1
    readme_dest="$state_dir/readme.md"
    docs_dest="$state_dir/docs"
    mkdir -p "$docs_dest"
    log_file_read "$readme_src"
    log_file_write "$readme_dest"
    cp "$readme_src" "$readme_dest"
    for doc_src in "$docs_src"/*.md; do
      [ -f "$doc_src" ] || continue
      log_file_read "$doc_src"
      log_file_write "$docs_dest/$(basename "$doc_src")"
      cp "$doc_src" "$docs_dest/$(basename "$doc_src")"
    done

    echo "ruori: wrote $readme_dest and $docs_dest/"
    echo "ruori: ask your coding agent, in a session in this repo, to:"
    echo ""
    echo "  Read $readme_dest to get oriented, then follow"
    echo "  $docs_dest/new-repo-setup-guide.md to set up ruori for this repo"
    echo "  (the rest of $docs_dest/ has more detail if it's needed)."
    exit 0
    ;;
  list)
    fetch_pr_statuses
    fetch_usage_costs
    printf "%-3s %-30s %-10s %-8s %-10s %-9s %-45s %s\n" "CUR" "BRANCH" "ACTIVE" "CLAUDE" "PR" "USAGE" "SESSION" "PATH"
    for i in "${!paths[@]}"; do
      session_name="$(session_name_for "${branches[$i]}" "${paths[$i]}")"
      if tmux_has_session "$CONTAINER_MODE" "$session_name"; then
        active="yes"
        claude="$(claude_status_for "${paths[$i]}")"
      else
        active="no"
        claude="-"
      fi
      pr="$(pr_status_for "${branches[$i]}")"
      usage="$(usage_cost_for "${paths[$i]}")"
      cur="$(marker_for "${paths[$i]}")"
      printf "%-3s %-30s %-10s %-8s %-10s %-9s %-45s %s\n" "$cur" "${branches[$i]}" "$active" "$claude" "$pr" "$usage" "$session_name" "${paths[$i]}"
    done
    exit 0
    ;;
  ports)
    printf "%-30s %-8s %-8s %-40s %-50s %s\n" "BRANCH" "CPORT" "HPORT" "SESSION" "PATH" "URL"
    # Only container-ports marked ":http" (see container_ports) get a
    # URL here -- others (e.g. a database port) aren't browser-able.
    declare -A ports_http_label=()
    while IFS=$'\t' read -r cport_key cport_name cport_type; do
      [ "$cport_type" = "http" ] || continue
      ports_http_label["$cport_key"]=1
    done < <(container_ports)
    ports_file="$(ports_cache_file 2>/dev/null || true)"
    if [ -n "$ports_file" ] && [ -f "$ports_file" ]; then
      log_file_read "$ports_file"
      while IFS=$'\t' read -r row_session row_cport row_hport; do
        [ -n "$row_session" ] || continue
        for i in "${!paths[@]}"; do
          session_name="$(session_name_for "${branches[$i]}" "${paths[$i]}")"
          if [ "$session_name" = "$row_session" ]; then
            row_url="-"
            [ -n "${ports_http_label[$row_cport]:-}" ] && row_url="$(osc8_link "http://localhost:${row_hport}")"
            printf "%-30s %-8s %-8s %-40s %-50s %s\n" "${branches[$i]}" "$row_cport" "$row_hport" "$row_session" "${paths[$i]}" "$row_url"
          fi
        done
      done <"$ports_file"
    fi
    exit 0
    ;;
  resources)
    # Worktree-scoped entries below describe ONE worktree at a time
    # (default: whichever is "current" -- the * marker), the same
    # selector convention as `details`: a repo can have any number of
    # worktrees, so dumping every worktree's files in one go doesn't
    # scale and isn't what you want anyway -- you're almost always
    # asking "what does *this* worktree have", not "list them all".
    session_arg="${2:-}"
    found=-1
    if [ -n "$session_arg" ]; then
      for i in "${!paths[@]}"; do
        session_name="$(session_name_for "${branches[$i]}" "${paths[$i]}")"
        if [ "${branches[$i]}" = "$session_arg" ] || [ "$session_name" = "$session_arg" ]; then
          found=$i
          break
        fi
      done
      if [ "$found" -lt 0 ]; then
        echo "ruori: no worktree found for branch or session '$session_arg' (see 'ruori list')" >&2
        exit 1
      fi
    else
      for i in "${!paths[@]}"; do
        if [ "${paths[$i]}" = "$current_worktree_path" ]; then
          found=$i
          break
        fi
      done
      [ "$found" -ge 0 ] || found=0
    fi
    worktree_path="${paths[$found]}"
    worktree_branch="${branches[$found]}"
    worktree_session="$(session_name_for "$worktree_branch" "$worktree_path")"

    # Prints one "<path-or-name>" line then one "<description>" line,
    # both indented under a scope heading, with a blank separator line
    # after -- so every filesystem-backed entry is a full absolute path
    # a terminal can open directly, not a pattern the reader has to
    # resolve themselves.
    resources_section() {
      printf '%s\n--------------------------------\n' "$1"
    }
    resources_scope() {
      printf '\n    %s\n' "$1"
    }
    resources_entry() {
      printf '        %s\n        %s\n\n' "$1" "$2"
    }
    resources_none() {
      printf '        (none)\n\n'
    }

    common_dir="$(git_common_dir)" || common_dir="<unavailable>"
    dockerfile_rel="$(container_file_path)"

    printf 'Worktree: %s (%s)\n' "$worktree_branch" "$worktree_path"
    printf "(see 'ruori list' for other worktrees; pass a branch or session name, e.g. 'ruori resources %s', to see a different one)\n" "$worktree_branch"

    resources_section "Book-keeping"
    resources_scope "Global"
    resources_entry "$HOME/.claude/projects" "Not ruori's own file -- Claude Code's own session-transcript log, which Claude Code writes on its own with no setup. Nothing to manage yourself. ruori only reads it, to total up USAGE for a worktree whose Claude Code runs directly on the host (not in a container); it's updated continuously by Claude Code itself while a session runs there. For a worktree in container mode this path is irrelevant -- its own transcripts live inside the container instead, unless this repo shares Claude Code's login via RUORI_SHARED_DIR (see docs/container-sandbox-guide.md's 'Recipe: Claude Code auth'), in which case ruori also scans <ruori-state-dir>/shared/*/projects the same way; otherwise see .ruori/agent-usage under Worktree below."
    resources_scope "Repository"
    resources_entry "$common_dir/ruori" "Everything ruori itself keeps for this repo lives under this one directory -- delete it any time ('rm -rf') to reset all local ruori state for this repo in one shot; every entry below is a file or subdirectory inside it. ruori recreates whatever it needs (this directory included) on its next invocation."
    resources_entry "$common_dir/ruori/current-worktree" "Internal to ruori, no need to open it. Remembers which worktree you last switched to, so the picker's * marker survives across separate 'ruori' runs. Written by ruori itself on every switch; read once on startup."
    resources_entry "$common_dir/ruori/host-mode-ack" "Internal to ruori, safe to delete to bring the blocking nudge back. Marks that you've acknowledged (via 'ruori --host-mode-fine') that host mode is fine for this repo, downgrading the 'container mode is OFF' prompt before the manager loop starts to a one-line reminder printed every run instead of something you press Enter past. Only relevant when container mode isn't on for this repo; written once by that flag, checked on every 'switch'/'new'."
    resources_entry "$common_dir/ruori/activation-times" "Internal to ruori, safe to delete. One line per worktree with the epoch time it was last activated, used only to sort the picker/list so your most recently used worktree sorts first. Rewritten by ruori every time you switch to a worktree."
    resources_entry "$common_dir/ruori/pr-status.cache" "Internal to ruori; delete it any time to force a re-fetch. Caches each branch's GitHub PR status so the picker doesn't call 'gh' on every reload. Written only by a Ctrl-F fetch in the picker, or by 'ruori list'/'ruori details' (which always fetch fresh); read on every other picker reload."
    resources_entry "$common_dir/ruori/usage-cost.cache" "Internal to ruori; delete it any time to force a re-fetch. Caches each worktree's total Claude Code spend (sourced from ~/.claude/projects, RUORI_SHARED_DIR, or .ruori/agent-usage -- see both above/below) so the picker doesn't rescan your whole Claude Code history on every reload. Written by the same Ctrl-F / 'list' / 'details' fetches as the PR cache above."
    resources_entry "$common_dir/ruori/ports" "Internal to ruori; only matters in container mode. A worktree's host port is only seeded by a hash of it -- ruori then scans forward from that seed for the first port that's actually free, so the final pick depends on ambient state (what else is running) at that moment, not the hash alone. Docker bakes that exact port into the container permanently at creation and won't let it change without recreating the container, so ruori has to remember what it picked here rather than recomputing it later and risking a different answer. Written when a container-mode worktree's container first starts; its entries are dropped when that worktree is removed ('ruori rm')."
    resources_entry "$common_dir/ruori/iterm.log" "Debug-only -- you don't need to read this unless an iTerm2 window is misbehaving (see docs/troubleshooting.md). An append-only log of the manager loop's own iTerm2 window open/close lifecycle. Written continuously by ruori for as long as the manager loop ('ruori' with no args) keeps running."
    resources_entry "$common_dir/ruori/file-io.log" "Debug-only -- for troubleshooting/transparency (see docs/troubleshooting.md). An append-only log of every read/write ruori's own script code performs against a file (state/cache files, $CONFIG_FILENAME, worktree copy-in, generated files) -- not file access done inside a child process it shells out to (git, docker, code, fzf, osascript), which isn't observable here. Written by every ruori command that touches a file, including read-only ones like 'list'."
    resources_entry "$common_dir/ruori/overlay.log" "Debug-only -- for troubleshooting a container-overlay that looks stale (see docs/troubleshooting.md). An append-only log of every container-overlay patch-apply failure, with the reason and which .rej file (if any) to inspect. Written only when a 'container-overlay' directive's patch fails to apply against the current host file."
    resources_entry "$common_dir/ruori/iterm-window" "Internal to ruori. Tracks the single iTerm2 window id the manager loop currently owns, so switching worktrees closes the right window before opening a new one instead of leaking windows behind. Written by ruori every time it opens or closes that window; only meaningful while the manager loop is running."
    resources_entry "$common_dir/ruori/shared" "This is RUORI_SHARED_DIR (see the 'Managed resources' section below) -- only present if container mode is on. ruori itself never writes anything under it; whatever's there was put there by this repo's own Dockerfile/entrypoint (e.g. 'ruori-claude-home', if this repo shares Claude Code's login -- see docs/container-sandbox-guide.md's 'Recipe: Claude Code auth')."
    resources_entry "$common_dir/ruori/readme.md" "Not read back by ruori -- a plain copy of ruori's own README.md, written by 'ruori init' alongside the docs/ copy below for you to hand to a coding agent (any agent; it's just a file, not a Claude Code skill). Safe to delete once an agent has read it; re-run 'ruori init' any time for a fresh copy."
    resources_entry "$common_dir/ruori/docs" "Not read back by ruori -- a plain copy of every file in ruori's own docs/ directory (the tool's docs, not this repo's), written by 'ruori init' so an agent has everything new-repo-setup-guide.md (the file to actually follow) links out to, without a second, agent-only copy of any of it. Safe to delete once an agent has acted on it; re-run 'ruori init' any time for a fresh copy."
    resources_scope "Worktree"
    resources_entry "$worktree_path/.ruori" "Everything an external agent hook writes at this worktree's root lives under this one directory -- not written by ruori itself, but ruori only ever reads the two well-known files below from it. Needs a **global** gitignore entry (not a per-repo one), or 'git worktree remove' will refuse to remove this worktree."
    resources_entry "$worktree_path/$CLAUDE_STATUS_FILENAME" "You don't write this, but it's worth knowing about: it's what makes the picker's CLAUDE (busy/waiting/idle) column work for this worktree. Written by Claude Code's own hooks -- baked into this repo's container image following the guide 'ruori init' copies out, never by ruori itself -- every time Claude's status changes. Only present/updated if this worktree runs in container mode."
    resources_entry "$worktree_path/$AGENT_USAGE_FILENAME" "Same story as the status file above: not written by ruori, and takes priority over the host-side scan when present and fresh (see Global above) -- the working source of the USAGE number for a worktree running in a container that does NOT share Claude Code's login via RUORI_SHARED_DIR (its own ~/.claude/projects isn't visible to the host otherwise). Written by that same container-baked Claude Code hook each time Claude goes idle, as a running total, if that hook computes one -- this repo's own hook doesn't (see docs/container-sandbox-guide.md's 'Recipe: Claude Code auth'), relying on the host-side scan instead."

    resources_section "Configuration"
    resources_scope "Global"
    resources_none
    resources_scope "Repository"
    resources_entry "$main_worktree_path/$CONFIG_FILENAME" "Yours to write and edit -- ruori never creates or modifies it, only reads it. Tells ruori which gitignored files to copy into a fresh worktree ('copy') and whether/how to run this repo in container mode ('container*' directives). Read fresh on every ruori invocation; see docs/config-file.md."
    resources_entry "$main_worktree_path/$dockerfile_rel" "Yours to write, usually with a coding agent's help after 'ruori init' (see $common_dir/ruori/docs/new-repo-setup-guide.md above) -- ruori only reads it, to 'docker build' this repo's shared image. Only matters if $CONFIG_FILENAME has 'container on'; ruori never looks at it otherwise. Read (and rebuilt from) fresh on every container start, so editing it takes effect on your next switch."
    while IFS=$'\t' read -r overlay_relpath overlay_patchrel; do
      [ -n "$overlay_relpath" ] || continue
      resources_entry "$main_worktree_path/$overlay_patchrel" "Yours to write once -- a unified diff (e.g. 'git diff -- $overlay_relpath > this-file') authored against a scratch copy of '$overlay_relpath', then tracked in git like $CONFIG_FILENAME/the Dockerfile. ruori only reads it, applying it to this worktree's *current* '$overlay_relpath' each time this worktree's container is created or rebuilt (see docs/container-sandbox-guide.md's overlay recipe) -- overrides that path inside that container only; the host file is never touched. Not re-applied to an already-running container; edit the patch or the host file before your next 'ruori rebuild' to change what a fresh container gets."
    done < <(container_overlay_entries)
    resources_scope "Worktree"
    resources_none

    resources_section "Managed resources"
    resources_scope "Global"
    resources_none
    resources_scope "Repository"
    if container_mode_enabled; then
      resources_entry "$(container_image_for)" "Not something you manage day to day. One Docker image shared by every worktree of this repo, built by ruori from the Dockerfile above the first time it's needed, and rebuilt (Docker's own layer cache keeps repeat builds fast) the next time you switch to any worktree after you change that Dockerfile."
      resources_entry "RUORI_SHARED_DIR (env var, inside any container)" "Not a file ruori manages -- an env var ruori injects into every worktree's container, pointing at this repo's shared, writable, cross-worktree storage (today, the common git dir above). Your own Dockerfile/entrypoint can read it to persist or live-share state across every worktree's container, e.g. a shared Claude Code login -- see docs/container-sandbox-guide.md's 'Recipe: Claude Code auth'. ruori itself never writes anything under it."
    else
      resources_entry "(none)" "Container mode is off for this repo, so ruori builds no image -- see the 'container' directive in $CONFIG_FILENAME to turn it on."
    fi
    resources_scope "Worktree"
    resources_entry "$worktree_session" "Not a file, though 'tmux attach -t $worktree_session' works if you want to look. ruori creates this tmux session (or reuses it if already running) the moment you switch to this worktree; it keeps running in the background after you switch away, until 'ruori rm' or the picker's Enter menu ('delete worktree' or 'kill tmux') kills it."
    if container_mode_enabled; then
      resources_entry "$worktree_session" "This worktree's Docker container -- same name as its tmux session above. Created by ruori the first time you switch to this worktree; stopped (not removed) when its tmux session is killed, and only actually removed by 'ruori rm'. ruori also colors that tmux session's status bar (a hash of the session name, see container_color_for) to match this worktree's row in the picker -- a visual cue that you're on a container, set on every switch, not something you configure."
      resources_entry "(recorded in $common_dir/ruori/ports, once allocated)" "Not something you manage directly -- see 'ruori ports' for this worktree's live host-port mapping, if its container has started at least once. Allocated by ruori the first time this worktree's container starts, and freed when the worktree is removed."
      native_volumes="$(docker volume ls -q --filter "name=^${worktree_session}__vol-" 2>/dev/null)"
      if [ -n "$native_volumes" ]; then
        while IFS= read -r native_volume; do
          [ -n "$native_volume" ] || continue
          resources_entry "$native_volume" "Not a file -- a Docker-managed volume (not the worktree's own filesystem) shadowing one subpath of this worktree inside the container, per a 'container-volume' directive in $CONFIG_FILENAME (see docs/container-sandbox-guide.md). Created the first time this worktree's container starts, or on 'ruori rebuild' for a directive added since; only actually removed by 'ruori rm', same as the container itself -- queried here by name, not by re-reading the current directive, so it's still listed even if that directive has since been edited or removed."
        done <<<"$native_volumes"
      fi
      if [ -n "$(container_host_ports)" ]; then
        resources_entry "socat process(es) inside $worktree_session" "Not a file -- one background 'socat' process per configured container-host-port, running inside this worktree's container, relaying localhost:<port> there to host.docker.internal:<port> on the host (see the 'container-host-port' directive in $CONFIG_FILENAME and docs/container-sandbox-guide.md). Started by ruori via 'docker exec -d' every time the container transitions to running -- 'docker stop' kills these along with everything else in the container, so they're never persisted or tracked in a file."
      fi
      while IFS=$'\t' read -r overlay_relpath overlay_patchrel; do
        [ -n "$overlay_relpath" ] || continue
        resources_entry "$(container_overlay_generated_file_for "$worktree_session" "$overlay_relpath")" "Not something you edit -- generated by ruori (the patch above applied to this worktree's '$overlay_relpath', as it looked at that moment) the first time this worktree's container starts, or again on 'ruori rebuild', and bind-mounted read-only over '$overlay_relpath' inside that container, so only the container sees this content; the host's real '$overlay_relpath' is untouched. Not regenerated for an already-running container -- see the patch file above. Safe to delete; ruori recreates it the next time this worktree's container is created or rebuilt."
      done < <(container_overlay_entries)
    fi
    exit 0
    ;;
  switch)
    ;;
  new)
    branch_arg="${2:-}"
    start_point="${3:-}"
    if [ -z "$branch_arg" ]; then
      echo "ruori: usage: ruori new <branch> [start-point]" >&2
      exit 1
    fi
    created_worktree_path=""
    create_worktree_for_branch "$branch_arg" "$start_point" || exit 1
    pending_activate_path="$created_worktree_path"
    pending_activate_branch="$branch_arg"
    ;;
  rm)
    branch_arg="${2:-}"
    if [ -z "$branch_arg" ]; then
      echo "ruori: usage: ruori rm <branch>" >&2
      exit 1
    fi
    found=-1
    for i in "${!paths[@]}"; do
      if [ "${branches[$i]}" = "$branch_arg" ]; then
        found=$i
        break
      fi
    done
    if [ "$found" -lt 0 ]; then
      echo "ruori: no worktree found for branch '$branch_arg' (see 'ruori list')" >&2
      exit 1
    fi
    session_name="$(session_name_for "${branches[$found]}" "${paths[$found]}")"
    delete_worktree "${paths[$found]}" "${branches[$found]}" "$session_name"
    exit $?
    ;;
  rebuild)
    branch_arg="${2:-}"
    if [ -z "$branch_arg" ]; then
      echo "ruori: usage: ruori rebuild <branch>" >&2
      exit 1
    fi
    if [ "$CONTAINER_MODE" != "1" ]; then
      echo "ruori: 'rebuild' only applies in container mode (see 'container on' in ${CONFIG_FILENAME})" >&2
      exit 1
    fi
    found=-1
    for i in "${!paths[@]}"; do
      if [ "${branches[$i]}" = "$branch_arg" ]; then
        found=$i
        break
      fi
    done
    if [ "$found" -lt 0 ]; then
      echo "ruori: no worktree found for branch '$branch_arg' (see 'ruori list')" >&2
      exit 1
    fi
    session_name="$(session_name_for "${branches[$found]}" "${paths[$found]}")"
    rebuild_container_for "$session_name" "${paths[$found]}"
    exit $?
    ;;
  details)
    # Accepts either the branch name or the tmux/container session name
    # (the latter being what the picker's preview panel and `ruori list`'s
    # SESSION column actually show) — whichever the caller has handy.
    session_arg="${2:-}"
    if [ -z "$session_arg" ]; then
      echo "ruori: usage: ruori details <branch-or-session>" >&2
      exit 1
    fi
    found=-1
    for i in "${!paths[@]}"; do
      session_name="$(session_name_for "${branches[$i]}" "${paths[$i]}")"
      if [ "${branches[$i]}" = "$session_arg" ] || [ "$session_name" = "$session_arg" ]; then
        found=$i
        break
      fi
    done
    if [ "$found" -lt 0 ]; then
      echo "ruori: no worktree found for branch or session '$session_arg' (see 'ruori list')" >&2
      exit 1
    fi
    session_name="$(session_name_for "${branches[$found]}" "${paths[$found]}")"
    fetch_pr_statuses
    fetch_usage_costs
    if tmux_has_session "$CONTAINER_MODE" "$session_name"; then
      active="yes"
      claude="$(claude_status_for "${paths[$found]}")"
    else
      active="no"
      claude="-"
    fi
    cur="no"
    [ "${paths[$found]}" = "$current_worktree_path" ] && cur="yes"
    printf 'Branch:  %s\n' "${branches[$found]}"
    printf 'Current: %s\n' "$cur"
    printf 'Path:    %s\n' "${paths[$found]}"
    printf 'Session: %s\n' "$session_name"
    printf 'Active:  %s\n' "$active"
    printf 'CLAUDE:  %s\n' "$claude"
    printf 'PR:      %s\n' "$(pr_status_for "${branches[$found]}")"
    printf 'USAGE:   %s\n' "$(usage_cost_for "${paths[$found]}")"
    if [ "$CONTAINER_MODE" = "1" ]; then
      printf 'Docker:  %s\n' "$(container_state_for "$session_name")"
      printf 'Cont.ID: %s\n' "$(container_id_for "$session_name")"
      printf 'Image:   %s\n' "$(container_image_info_for)"
      printf 'Ports:   %s\n' "$(container_ports_info_for "$session_name")"
      while IFS=$'\t' read -r link_label link_url; do
        printf 'URL:     %s: %s\n' "$link_label" "$(osc8_link "$link_url")"
      done < <(browser_links_for "$session_name")
    fi
    exit 0
    ;;
  terminal)
    # Same selector convention as `resources`: a branch or session name,
    # or nothing to default to whichever worktree is "current" (the *
    # marker) -- the common case being "give me a host shell on whatever
    # I'm on right now", not naming a worktree explicitly.
    session_arg="${2:-}"
    found=-1
    if [ -n "$session_arg" ]; then
      for i in "${!paths[@]}"; do
        session_name="$(session_name_for "${branches[$i]}" "${paths[$i]}")"
        if [ "${branches[$i]}" = "$session_arg" ] || [ "$session_name" = "$session_arg" ]; then
          found=$i
          break
        fi
      done
      if [ "$found" -lt 0 ]; then
        echo "ruori: no worktree found for branch or session '$session_arg' (see 'ruori list')" >&2
        exit 1
      fi
    else
      for i in "${!paths[@]}"; do
        if [ "${paths[$i]}" = "$current_worktree_path" ]; then
          found=$i
          break
        fi
      done
      [ "$found" -ge 0 ] || found=0
    fi
    open_host_terminal_for "${paths[$found]}" "${branches[$found]}"
    exit 0
    ;;
  __fzfgen)
    # Hidden: invoked by the picker's own fzf `reload` binding (Ctrl-R,
    # Ctrl-N), not a user-facing command. Loads the PR/usage
    # *caches* only — never fetches from `gh` or scans ~/.claude/projects
    # — so this stays fast; Ctrl-F (__fzfgen_fetch, below) is the only
    # thing that does the slow fetch. Must emit the header line first,
    # matching the initial fzf_input the picker seeds itself with (see
    # below) — the picker uses --header-lines=1, so a reload without it
    # would make the first real row disappear into the header slot.
    load_pr_status_cache
    load_usage_cost_cache
    [ "$CONTAINER_MODE" = "1" ] && refresh_docker_container_table
    fzf_header_line
    for i in "${!paths[@]}"; do
      fzf_line_for "$i"
    done
    exit 0
    ;;
  __fzfgen_fetch)
    # Hidden: invoked only by the picker's Ctrl-F binding. Refreshes both
    # of the slow, "go get new info" columns in one go — GitHub PR status
    # (one or more network round-trips) and Claude Code usage cost
    # (a scan of every session transcript on the machine) — rather than
    # having a separate refresh key per slow column.
    fetch_pr_statuses
    fetch_usage_costs
    [ "$CONTAINER_MODE" = "1" ] && refresh_docker_container_table
    fzf_header_line
    for i in "${!paths[@]}"; do
      fzf_line_for "$i"
    done
    exit 0
    ;;
  __new_prompt)
    # Hidden: invoked only by the picker's Ctrl-N binding. Only *creates*
    # the worktree here — it deliberately doesn't also activate it (no
    # tmux/container start, no VS Code/iTerm2 window): this runs as a
    # one-off subprocess via fzf's `execute`, and the iTerm2 window
    # open/close lifecycle (active_iterm_window_id) lives only in the
    # persistent manager loop's own memory, not on disk, so a subprocess
    # opening/closing a window here would leave the parent loop's tracked
    # id stale. Instead this just creates the branch/worktree and reloads
    # the list; the reload surfaces the new row, and picking it with Enter
    # (the normal switch path, already running in the parent loop) is what
    # actually opens tmux/VS Code/iTerm2 for it.
    read -r -p "New branch name: " branch_name
    if [ -z "$branch_name" ]; then
      echo "ruori: aborted, no branch name given"
    else
      created_worktree_path=""
      create_worktree_for_branch "$branch_name" ""
    fi
    exit 0
    ;;
  *)
    echo "ruori: unknown command '$cmd' (expected 'switch', 'new', 'list', 'rm', 'ports', or 'resources')" >&2
    exit 1
    ;;
esac

# Container mode is opt-in (see CONTAINER_MODE above) and strongly
# recommended: host mode runs the tmux session -- and whatever agent it's
# running with permission checks off -- directly on the host, able to touch
# anything the host user account can. This is a per-run notice, not a
# gate: it always falls through to host mode, same as today. Only shown
# on the interactive paths that reach the manager loop below ('switch'/
# 'new'); one-shot commands (list/ports/rm/details/resources) exit inside
# the case block above and never see it. Once `ruori --host-mode-fine`
# has acknowledged it for this repo (see host_mode_ack_file above and the
# flag-stripping code before command dispatch), this downgrades from a
# blocking prompt to a one-line reminder printed every run -- still
# visible so it's never silently forgotten which mode a repo is in, but
# no longer something you have to press Enter past each time.
host_mode_ack_file_path="$(host_mode_ack_file 2>/dev/null)" || host_mode_ack_file_path=""
if [ "$CONTAINER_MODE" != "1" ]; then
  log_file_read "$host_mode_ack_file_path"
  if [ -f "$host_mode_ack_file_path" ]; then
    echo "ruori: host mode is fine for this repo. Won't nudge about container mode again (delete $host_mode_ack_file_path, or see 'ruori resources', to bring the nudge back)." >&2
  else
    echo "ruori: container mode is OFF for this repo" >&2
    echo "ruori: see https://github.com/Arch-vile/ruori/blob/main/readme.md for why and how you should use container mode" >&2
    echo "ruori: run 'ruori --host-mode-fine' once to silence this nudge for this repo" >&2
    read -r -p "ruori: press Enter to continue in host mode... " _container_nudge_ack
  fi
fi

# Tracks the iTerm2 window opened for the currently-active worktree, so
# switching worktrees replaces it instead of piling up one window per
# switch. Empty until the first successful switch. Re-synced from disk by
# load_active_iterm_window_id at the top of every open_iterm_window_for
# call, so this initial value only matters for the sliver of time before
# that first call.
active_iterm_window_id=""

# Debug log for the iTerm2 window open/close lifecycle — every id ruori
# thinks is active, every close it attempts, every window it opens, and
# whether each of those actually did what ruori expected. Exists because
# "the previous worktree's terminal window doesn't get closed" reports
# are otherwise very hard to diagnose after the fact: by the time you
# notice a leftover window, ruori's own in-memory state (what it *thought*
# it had just closed/opened) is long gone. Appended to, never rotated or
# cleared automatically — see README "Troubleshooting: leftover iTerm2
# windows" for how to read/clear it.
iterm_log_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/iterm.log' "$state_dir"
}

log_iterm() {
  local f
  f="$(iterm_log_file)" || return 0
  log_file_write "$f"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$f" 2>/dev/null || true
}

# All the currently open iTerm2 window ids, space-separated. Used by
# open_iterm_window_for to detect a new window even when the AppleEvent
# that requested it doesn't report back cleanly (see below).
#
# `osascript` exits non-zero on things like AppleEvents permission being
# denied, which two call sites below assign straight from (`before_ids=`/
# `after_ids=`) — under the script's `set -e`, an unguarded failure here
# would kill the whole manager loop mid-switch instead of surfacing the
# friendly "enable AppleEvents" message further down, so `|| true` keeps
# that outcome from propagating as this function's own exit status.
iterm_window_ids() {
  osascript -e 'tell application "iTerm2" to id of every window' 2>/dev/null | tr -d ',' || true
}

# Where the id of the currently-tracked iTerm2 window is persisted, so a
# restarted manager can still close the window its predecessor opened.
# Without this the id lived only in active_iterm_window_id above, and
# restarting `ruori` (to pick up an update, say) orphaned whatever window
# was open: the fresh process started with no id, skipped the close on
# the next switch, and left two worktree windows on screen.
iterm_window_state_file() {
  local state_dir
  state_dir="$(ruori_state_dir)" || return 1
  printf '%s/iterm-window' "$state_dir"
}

# iTerm2's current pid, or empty if it isn't running. Recorded alongside
# the window id because iTerm2 numbers windows from a counter that
# restarts with the app: an id persisted under a previous iTerm2 run can
# name a completely unrelated window in the current one, and closing that
# would throw away real work. A pid mismatch therefore means "different
# iTerm2, this id is meaningless" — see load_active_iterm_window_id.
#
# Deliberately not `pgrep -x iTerm2`: `-x` requires an exact match against
# the process's reported command name, but on at least one real setup (an
# iTerm2 install under `~/Applications` rather than `/Applications`) macOS
# reports that name as the full executable path rather than the bare
# `iTerm2`, so `-x iTerm2` silently never matches. The practical effect
# was total, permanent breakage: every save wrote an empty pid field,
# every subsequent load treated that as "iTerm2 is not running", and
# `load_active_iterm_window_id` discarded the tracked window on every
# single switch from then on — see docs/troubleshooting.md's "leftover
# iTerm2 windows" for how this actually presented (old windows piling up
# instead of being replaced). `ps` matching the trailing path component
# instead of demanding an exact name tolerates both a bare `iTerm2` comm
# and a full-path one.
#
# No match (iTerm2 not running, or nothing found) is a normal, expected
# outcome here, not a failure, so callers can tell "not running" apart
# from "running". Under the script's `set -e`, an unguarded pipeline
# would instead kill the whole manager loop the instant iTerm2 wasn't
# found, with zero output to explain why, so `|| true` keeps that outcome
# from propagating as this function's own exit status.
iterm_pid() {
  ps -axo pid=,comm= 2>/dev/null | awk '
    { pid = $1; $1 = ""; sub(/^ /, ""); comm = $0 }
    comm == "iTerm2" || comm ~ /\/iTerm2$/ { print pid; exit }
  ' || true
}

save_active_iterm_window_id() {
  local f
  f="$(iterm_window_state_file)" || return 0
  if [ -n "$active_iterm_window_id" ]; then
    log_file_write "$f"
    printf '%s\t%s\n' "$(iterm_pid)" "$active_iterm_window_id" >"$f" 2>/dev/null || true
  else
    rm -f "$f" 2>/dev/null || true
  fi
}

# Re-sync active_iterm_window_id from disk. Called at the top of
# open_iterm_window_for, on every switch, not just once at manager
# startup: if more than one `ruori` manager loop is alive for the same
# repo (e.g. a second terminal tab left sitting at the picker), each
# process's own in-memory idea of "the currently open window" goes stale
# the instant a *different* process switches — this call is what lets a
# long-idle process still find and close whatever window is actually on
# screen right now instead of leaving it orphaned and piling up a new
# one. Also what lets a restart of `ruori` itself adopt the window a
# previous run left open. Only adopts when the persisted window is still
# open and still belongs to the same iTerm2 run; anything else and we
# forget it, which is the safe direction to be wrong in (a stray window
# the user closes by hand, rather than one ruori closes out from under
# them).
load_active_iterm_window_id() {
  local f saved_pid saved_id now_pid
  active_iterm_window_id=""
  f="$(iterm_window_state_file)" || return 0
  [ -f "$f" ] || return 0
  log_file_read "$f"
  IFS=$'\t' read -r saved_pid saved_id <"$f" || return 0
  [ -n "$saved_id" ] || return 0
  now_pid="$(iterm_pid)"
  if [ -z "$now_pid" ]; then
    log_iterm "not adopting persisted window id=${saved_id}: iTerm2 is not running"
    rm -f "$f" 2>/dev/null || true
    return 0
  fi
  if [ "$saved_pid" != "$now_pid" ]; then
    log_iterm "not adopting persisted window id=${saved_id}: recorded under iTerm2 pid ${saved_pid:-<none>}, now ${now_pid} — window ids are reused across restarts"
    rm -f "$f" 2>/dev/null || true
    return 0
  fi
  case " $(iterm_window_ids) " in
    *" ${saved_id} "*)
      active_iterm_window_id="$saved_id"
      log_iterm "adopted persisted window id=${saved_id} left by a previous manager process"
      ;;
    *)
      log_iterm "not adopting persisted window id=${saved_id}: no such window is open any more"
      rm -f "$f" 2>/dev/null || true
      ;;
  esac
}

# Open a new iTerm2 window attached to the given tmux session, closing the
# previously-opened one first (if any), without touching this process or
# its terminal — this script is the persistent manager and must never be
# attached/exec'd into a worktree session itself.
#
# The command runs from a generated script file (rather than an inline
# AppleScript string) to sidestep nested-quoting hell, and it pauses on a
# non-zero exit so an attach failure is readable: many iTerm2 setups have
# "Close Sessions On End" enabled, which closes the window the instant the
# command exits — a fast failure would otherwise flash and vanish unread.
open_iterm_window_for() {
  local session="$1" use_container="${2:-0}" branch="${3:-}"
  local script_path new_window_id before_ids after_ids id
  local close_out close_ec still_open create_raw
  local attach_cmd session_check_cmd window_title

  # Bare `tmux`, not $tmux_bin, in container mode — the container's
  # tmux is whatever the project's Dockerfile installs, not necessarily
  # at the host's resolved path. `docker` itself, though, runs on the
  # host (to exec into the container), so it needs the same resolved-path
  # treatment as $tmux_bin below — this whole command runs inside a fresh
  # iTerm2-spawned process that won't see the manager's PATH.
  #
  # session_check_cmd mirrors tmux_has_session's own container/host
  # distinction, and is what tells a genuine attach failure apart from
  # the session/container simply having been torn down out from under
  # this window (the Enter menu's kill/stop or delete, `ruori rm`, or the
  # session's last pane just exiting on its own) — see the generated
  # script below.
  if [ "$use_container" = "1" ]; then
    attach_cmd="'$docker_bin' exec -it '$session' tmux attach -t '$session'"
    session_check_cmd="'$docker_bin' exec '$session' tmux has-session -t '$session'"
    window_title="${repo_name}/${branch} (container)"
  else
    attach_cmd="'$tmux_bin' attach -t '$session'"
    session_check_cmd="'$tmux_bin' has-session -t '$session'"
    window_title="${repo_name}/${branch}"
  fi

  # Re-sync from disk rather than trusting whatever this process loaded
  # at its own startup — see load_active_iterm_window_id's comment.
  load_active_iterm_window_id

  log_iterm "open_iterm_window_for: session=${session} active_iterm_window_id(before)=${active_iterm_window_id:-<none>}"

  if [ -n "$active_iterm_window_id" ]; then
    log_iterm "closing previous window id=${active_iterm_window_id}"
    # Best-effort: the user may have already closed it by hand.
    close_out="$(osascript -e "tell application \"iTerm2\" to close (windows whose id is ${active_iterm_window_id})" 2>&1)"
    close_ec=$?
    # iTerm2's `close` returns before the window has actually gone, so
    # looking once straight afterwards reported "still open" on virtually
    # every successful switch — the warning below fired constantly and
    # meant nothing. Give the window up to ~2s to disappear first.
    still_open="yes"
    for _ in $(seq 1 20); do
      case " $(iterm_window_ids) " in
        *" ${active_iterm_window_id} "*) ;;
        *) still_open="no"; break ;;
      esac
      sleep 0.1
    done
    log_iterm "close attempt: id=${active_iterm_window_id} exit=${close_ec} output=${close_out:-<empty>} still_open_after_wait=${still_open}"
    if [ "$still_open" = "yes" ]; then
      echo "ruori: warning: iTerm2 window ${active_iterm_window_id} did not close — see $(iterm_log_file 2>/dev/null || echo '<log file>')" >&2
    fi
    active_iterm_window_id=""
    save_active_iterm_window_id
  fi

  script_path="$(mktemp -t ruori-attach)"
  log_file_write "$script_path"
  cat >"$script_path" <<SCRIPT
#!/bin/bash
# iTerm2 otherwise titles the window after the foreground job (e.g.
# "docker" or "tmux") — this OSC sets a fixed title instead, and (unlike
# an AppleScript-side \`set name of session\`) it survives exec'ing into
# the attach command below since it's the window's own emitted title.
printf '\033]0;%s\007' "$window_title"
$attach_cmd
ec=\$?
if [ "\$ec" -ne 0 ] && $session_check_cmd >/dev/null 2>&1; then
  # The session/container is still there, so this wasn't just it being
  # torn down (the Enter menu's kill/stop or delete, \`ruori rm\`, or its
  # last pane exiting on its own) — a real attach failure, worth pausing
  # to read.
  echo
  echo "[ruori] tmux attach exited with code \$ec"
  echo "[ruori] press Enter to close this window"
  read -r
fi
rm -f "$script_path"
SCRIPT
  chmod +x "$script_path"

  before_ids=" $(iterm_window_ids) "
  log_iterm "window ids before create: ${before_ids}"

  create_raw="$(osascript 2>&1 <<EOF
tell application "iTerm2"
  activate
  set newWindow to (create window with default profile command "${script_path}")
  return id of newWindow
end tell
EOF
  )"
  log_iterm "create window raw output: ${create_raw:-<empty>}"

  # A clean success is a bare numeric id; anything else (empty, or an
  # AppleScript error message — e.g. a timeout, observed in practice even
  # though iTerm2 goes ahead and creates the window a moment later
  # anyway) is treated as "unknown", not as that garbage text becoming
  # the tracked id.
  case "$create_raw" in
    ''|*[!0-9]*) new_window_id="" ;;
    *) new_window_id="$create_raw" ;;
  esac

  # If we didn't get a clean id back, we'd otherwise never learn this
  # window's id, meaning we could never close it on the *next* switch
  # (the very leak this was reported for: previous worktrees' windows
  # piling up instead of being replaced). Fall back to diffing the
  # window-id list, giving iTerm a moment to actually finish creating it
  # first.
  if [ -z "$new_window_id" ]; then
    log_iterm "create did not return a clean id; falling back to window-id diff"
    sleep 1
    after_ids=" $(iterm_window_ids) "
    log_iterm "window ids after create (+1s sleep): ${after_ids}"
    for id in $after_ids; do
      case "$before_ids" in
        *" $id "*) ;;
        *) new_window_id="$id"; break ;;
      esac
    done
    if [ -n "$new_window_id" ]; then
      log_iterm "diff found new window id=${new_window_id}"
    else
      log_iterm "diff found no new window id"
    fi
  fi

  if [ -n "$new_window_id" ]; then
    active_iterm_window_id="$new_window_id"
    save_active_iterm_window_id
    log_iterm "tracking window id=${new_window_id} for session=${session}"
  else
    log_iterm "FAILED to open/track a window for session=${session}"
    echo "ruori: failed to open an iTerm2 window (is iTerm2 installed, and is 'Allow all apps to control iTerm2 via AppleEvents' enabled in iTerm2 > Settings > General > Magic?)" >&2
  fi
}

# Opens a brand-new iTerm2 window with a plain login shell rooted at
# $1 -- always on the host, even for a container-mode worktree, unlike
# open_iterm_window_for's attach-into-tmux/-container window. This is
# for the "host-side tooling" work docs/container-sandbox-guide.md
# describes (a native `pnpm install`, one-off git commands, ...) that's
# meant to run outside any ruori session entirely (see 'ruori terminal'
# in docs/commands.md).
#
# Deliberately untracked by active_iterm_window_id: it's not "the"
# managed window a switch replaces, just an extra one you open by hand
# and close by hand, same as any other iTerm2 window.
open_host_terminal_for() {
  local target_path="$1" branch="$2"
  local window_title="${repo_name}/${branch} (terminal)"
  local script_path create_raw

  script_path="$(mktemp -t ruori-terminal)"
  log_file_write "$script_path"
  cat >"$script_path" <<SCRIPT
#!/bin/bash
printf '\033]0;%s\007' "$window_title"
# Unlinking here (rather than after, as open_iterm_window_for does)
# because the exec below never returns to run a later line -- bash has
# already read this short script into its buffer by the time it gets
# here, so the unlink is safe.
rm -f "$script_path"
cd "$target_path" || exit 1
exec "\${SHELL:-/bin/bash}" -l
SCRIPT
  chmod +x "$script_path"

  create_raw="$(osascript 2>&1 <<EOF
tell application "iTerm2"
  activate
  create window with default profile command "${script_path}"
end tell
EOF
  )"
  log_iterm "open_host_terminal_for: branch=${branch} path=${target_path} osascript_output=${create_raw:-<empty>}"
}

# Everything a pick (or a freshly created worktree, see 'new' above) needs
# to become "the active worktree": env-file copy-in, tmux/container session
# start-or-reuse, VS Code, iTerm2 window, and persisting it as current for
# next time. Shared by the manager loop below and the 'new' command so
# `ruori new <branch>` doesn't require also fzf-picking the branch it just
# created.
activate_worktree() {
  local target_path="$1" session_name="$2" target_branch="$3"

  sync_env_files "$target_path"

  if [ "$CONTAINER_MODE" = "1" ]; then
    container_start_if_needed "$session_name" "$target_path"
    warn_container_volume_drift "$session_name" "$target_path" "$target_branch"
    warn_container_overlay_drift "$session_name" "$target_path" "$target_branch"
    if docker exec "$session_name" tmux has-session -t "$session_name" 2>/dev/null; then
      echo "ruori: resuming existing session for ${target_branch}"
    else
      # No command is ever sent in here — whatever starts (an agent, a
      # shell, nothing) is entirely up to the container image's own
      # CMD/entrypoint or tmux default-command. See
      # docs/container-sandbox-plan.md decision on agent-agnosticism.
      docker exec -d "$session_name" tmux new-session -d -s "$session_name" -c "$target_path"
    fi
    # Visual "you're on a container" cue (issue #30): color this
    # session's tmux status bar, so it shows in *any* terminal attached
    # to it -- the iTerm2 window below, but also a manual attach or a
    # VS Code terminal -- not just something ruori's own window paints.
    # status-bg/status-fg rather than the newer combined status-style,
    # since they're understood by every tmux version status-style is
    # (tmux aliases them internally) plus older ones a container image
    # might still bundle. Set on every activation, not just on session
    # creation, since it's cheap/idempotent and a session already
    # running from before this feature existed would otherwise never
    # pick it up. See container_color_for and fzf_line_for, which
    # colors this same worktree's picker row to match.
    docker exec "$session_name" tmux set-option -t "$session_name" status-bg "colour$(container_color_for "$session_name")" >/dev/null 2>&1
    docker exec "$session_name" tmux set-option -t "$session_name" status-fg colour232 >/dev/null 2>&1
  else
    if tmux has-session -t "$session_name" 2>/dev/null; then
      echo "ruori: resuming existing session for ${target_branch}"
    else
      tmux new-session -d -s "$session_name" -c "$target_path"
      # No tmux session existed yet for this worktree, but Claude Code may
      # still have a prior conversation on disk for this directory; --resume
      # with no id opens its own picker (with an option to start fresh).
      tmux send-keys -t "$session_name" 'claude --resume' C-m
    fi
  fi

  # -r reuses the existing VS Code window instead of opening a new one
  # per switch.
  code -r "$target_path"
  open_iterm_window_for "$session_name" "$CONTAINER_MODE" "$target_branch"

  # So the next loop iteration's picker (and this iteration's own
  # reloads, had there been any after this point) marks the worktree you
  # just switched to as current, not wherever `ruori` originally started —
  # and persisted to disk so a future, separate run of `ruori` remembers it
  # too, rather than always defaulting back to the main worktree.
  current_worktree_path="$target_path"
  save_current_worktree
  save_activation_time "$target_path"
}

# The manager loop: fzf-pick a worktree, spin up/attach its tmux session in
# the background, pop an iTerm2 window for it, then loop back to the picker
# so this terminal stays the persistent manager. Esc/Ctrl-C in fzf exits.
self_q="$(printf '%q' "$0")"

# The Enter action menu's "kill tmux"/"stop container" label: in
# container mode it stops the container outright (not just the tmux
# session inside it) — the container can be `docker start`ed again on
# the next switch, same as any other stopped container, and it's what
# the state column then reports as "stopped". Outside container mode
# there's no container to stop, so it falls back to killing the tmux
# session on the host tmux server, as before.
ctrl_x_label="kill tmux"
if [ "$CONTAINER_MODE" = "1" ]; then
  ctrl_x_label="stop container"
fi

# The preview panel's own field labels/order follow CONTAINER_MODE too:
# container mode appends the short container id (field 13) to the Docker
# state line, and adds the image (built or not), allocated host ports,
# and any ":http"-typed ports' clickable URLs (see
# container_id_for/container_image_info_for/container_ports_info_for/
# browser_links_summary_for and their fields 13/11/12/14 from
# fzf_line_for) below it, since those are exactly what the Enter menu's
# "stop container"/switching there actually change. No Session line:
# the container name doesn't add anything the id and branch don't already
# say.
if [ "$CONTAINER_MODE" = "1" ]; then
  fzf_preview_cmd='printf "Branch:  %s\nDocker:  %s (container %s)\nImage:   %s\nPorts:   %s\nURL:     %s\nCLAUDE:  %s\nPR:      %s\nUSAGE:   %s\nPath:    %s\n" {10} {3} {13} {11} {12} {14} {4} {5} {6} {8}'
  fzf_preview_lines=10
else
  fzf_preview_cmd='printf "Branch:  %s\nTMUX:    %s\nCLAUDE:  %s\nPR:      %s\nUSAGE:   %s\nPath:    %s\nSession: %s\n" {10} {3} {4} {5} {6} {8} {9}'
  fzf_preview_lines=8
fi

echo "ruori: logging iTerm2 window open/close activity to $(iterm_log_file 2>/dev/null || echo '<unavailable>')" >&2
log_iterm "=== ruori manager loop starting (pid $$) ==="

# `ruori new <branch>` creates the worktree in the case block above (before
# these functions existed yet), then defers to here to actually activate
# it — same tmux/container/VS Code/iTerm2 sequence as fzf-picking it would
# have triggered, minus needing the user to also go pick it.
if [ -n "$pending_activate_path" ]; then
  parse_worktrees
  pending_session_name="$(session_name_for "$pending_activate_branch" "$pending_activate_path")"
  activate_worktree "$pending_activate_path" "$pending_session_name" "$pending_activate_branch"
fi

while true; do
  # Re-parse rather than trust arrays from a previous iteration: the
  # Enter action menu below can delete a worktree mid-session, and the
  # picker's own reloads (Ctrl-R/Ctrl-F) already always see current state
  # since each is a fresh process — this keeps the outer loop in sync too.
  parse_worktrees
  load_pr_status_cache
  load_usage_cost_cache
  [ "$CONTAINER_MODE" = "1" ] && refresh_docker_container_table
  fzf_input="$(fzf_header_line)"$'\n'
  for i in "${!paths[@]}"; do
    fzf_input+="$(fzf_line_for "$i")"$'\n'
  done

  selection="$(printf '%s' "$fzf_input" | fzf \
    --ansi --delimiter='\t' --with-nth=2,3,4,5,6,7 --prompt="worktree > " --layout=reverse \
    --header-lines=1 \
    --header="enter: actions · ctrl-n: new worktree · ctrl-r: refresh · ctrl-f: fetch PR/usage" \
    --preview "$fzf_preview_cmd" \
    --preview-window="bottom:${fzf_preview_lines}:wrap" \
    --bind "ctrl-n:execute(bash ${self_q} __new_prompt)+reload(bash ${self_q} __fzfgen)" \
    --bind "ctrl-r:reload(bash ${self_q} __fzfgen)" \
    --bind "ctrl-f:reload(bash ${self_q} __fzfgen_fetch)")"

  if [ -z "$selection" ]; then
    break
  fi

  # Read straight off the selected row's own fields (path, session,
  # raw-branch) rather than looking `idx` up in the paths/branches arrays:
  # the row came from this iteration's parse_worktrees, so it's already
  # authoritative, and the action menu below deleting a worktree
  # mid-picker-session means an index-based lookup could otherwise point
  # at a since-removed entry.
  selected_path="$(printf '%s' "$selection" | cut -f8)"
  session_name="$(printf '%s' "$selection" | cut -f9)"
  selected_branch="$(printf '%s' "$selection" | cut -f10)"

  log_iterm "switch selected: branch=${selected_branch} path=${selected_path} session=${session_name}"

  # Enter no longer switches straight away: it opens a small action menu
  # on the highlighted worktree, "switch to" first so it stays the fast
  # path, followed by the other per-worktree actions — a place for those
  # to live without each minting its own Ctrl-<letter> binding (see
  # issue #11). This runs after the outer fzf above has already exited,
  # so — unlike the old Ctrl-D/Ctrl-X bindings, which had to shell out via
  # `execute` to get the suspended terminal back — it's plain bash with
  # full access to activate_worktree/delete_worktree and the terminal.
  #
  # The preview below reuses the exact same layout as the outer picker's
  # own preview pane for this row, just resolved from the already-cut
  # $selection instead of fzf's {n} placeholders — the menu's own rows
  # ("switch to", "delete worktree", ...) carry no such fields for a
  # placeholder to refer to. Exported (not just a local var) because
  # fzf's --preview runs it in a separate spawned shell that doesn't see
  # this script's own variables otherwise; unset right after so it
  # doesn't linger for anything spawned later.
  if [ "$CONTAINER_MODE" = "1" ]; then
    export RUORI_MENU_PREVIEW="$(printf '%s' "$selection" | awk -F'\t' '{printf "Branch:  %s\nDocker:  %s (container %s)\nImage:   %s\nPorts:   %s\nURL:     %s\nCLAUDE:  %s\nPR:      %s\nUSAGE:   %s\nPath:    %s\n", $10, $3, $13, $11, $12, $14, $4, $5, $6, $8}')"
  else
    export RUORI_MENU_PREVIEW="$(printf '%s' "$selection" | awk -F'\t' '{printf "Branch:  %s\nTMUX:    %s\nCLAUDE:  %s\nPR:      %s\nUSAGE:   %s\nPath:    %s\nSession: %s\n", $10, $3, $4, $5, $6, $8, $9}')"
  fi

  # "open in browser" only shows up when there's actually a
  # ":http"-typed container-port allocated for this session (see
  # browser_links_for) -- no point offering it for host mode, a repo
  # with no ":http" ports, or a worktree whose container has never
  # started (nothing allocated yet).
  menu_items=("switch to" "delete worktree" "open host terminal")
  if [ "$CONTAINER_MODE" = "1" ]; then
    if [ -n "$(browser_links_for "$session_name")" ]; then
      menu_items+=("open in browser")
    fi
    menu_items+=("rebuild container")
  fi
  menu_items+=("$ctrl_x_label" "back")

  # `|| true`: fzf exits non-zero on Esc/Ctrl-C, which under this
  # script's `set -e` would otherwise kill the whole manager loop right
  # here instead of just falling through to the no-op case below and
  # looping back to the worktree picker.
  menu_choice="$(printf '%s\n' "${menu_items[@]}" \
    | fzf --prompt="action > " --header="${selected_branch} · esc: back to worktree list" --layout=reverse \
      --preview 'printf "%s" "$RUORI_MENU_PREVIEW"' \
      --preview-window="bottom:${fzf_preview_lines}:wrap")" || true
  unset RUORI_MENU_PREVIEW

  case "$menu_choice" in
    "switch to")
      activate_worktree "$selected_path" "$session_name" "$selected_branch"
      ;;
    "delete worktree")
      delete_worktree "$selected_path" "$selected_branch" "$session_name"
      ;;
    "open host terminal")
      open_host_terminal_for "$selected_path" "$selected_branch"
      ;;
    "open in browser")
      while IFS=$'\t' read -r link_label link_url; do
        printf '%s: %s\n' "$link_label" "$(osc8_link "$link_url")"
      done < <(browser_links_for "$session_name")
      read -r -p "Press Enter to continue..." _ || true
      ;;
    "rebuild container")
      rebuild_container_for "$session_name" "$selected_path" || true
      ;;
    "kill tmux"|"stop container")
      if [ "$CONTAINER_MODE" = "1" ]; then
        "$docker_bin" stop "$session_name" 2>/dev/null
      else
        "$tmux_bin" kill-session -t "$session_name" 2>/dev/null
      fi
      ;;
    *)
      # "back", Esc, or Ctrl-C on the action menu: no-op, loop back to
      # the picker rather than exiting the manager loop (only Esc on the
      # outer worktree picker above does that).
      ;;
  esac
done
